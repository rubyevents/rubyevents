#!/usr/bin/env node

/**
 * Usage: bin/screenshot <url> <output_path> [--attach-to-pr]
 * 
 * Examples:
 *   bin/screenshot http://localhost:3000 /tmp/homepage.png
 *   bin/screenshot http://localhost:3000/events /tmp/events.png --attach-to-pr
 */

const globalModuleDir = require('module').globalPaths;
const path = require('path');
const fs = require('fs');
const { execSync } = require('child_process');

// Try to load playwright from various locations
let playwright;
try {
  // Try global installation first
  playwright = require('/usr/local/lib/node_modules/playwright');
} catch (e) {
  try {
    // Try relative to project
    playwright = require('./node_modules/playwright');
  } catch (e2) {
    console.error('✗ Playwright not found. Install with: npm install -g playwright @playwright/test');
    process.exit(1);
  }
}

const { chromium } = playwright;

async function takeScreenshot(url, outputPath, attachToPr = false) {
  const browser = await chromium.launch();
  const page = await browser.newPage();

  try {
    // Navigate to the URL
    await page.goto(url, { waitUntil: 'networkidle' });

    // Wait for any animations to settle
    await page.waitForTimeout(500);

    // Take screenshot
    await page.screenshot({ 
      path: outputPath,
      fullPage: true 
    });

    console.log(`✓ Screenshot saved to ${outputPath}`);

    // If --attach-to-pr flag is set, attach to PR
    if (attachToPr) {
      try {
        const absolutePath = path.resolve(outputPath);
        const fileName = path.basename(outputPath);
        
        // Use gh pr view to get PR number
        const prInfo = execSync('gh pr view --json number -q .number 2>/dev/null || echo ""').toString().trim();
        
        if (prInfo) {
          // Attach file to PR using gh pr edit
          execSync(`gh pr edit --body-append "![${fileName}](file://${absolutePath})"`, { stdio: 'inherit' });
          console.log(`✓ Screenshot attached to PR`);
        } else {
          console.warn(`⚠ Not in a PR context. Screenshot saved but not attached.`);
        }
      } catch (e) {
        console.warn(`⚠ Could not attach screenshot to PR: ${e.message}`);
      }
    }

    return true;
  } catch (error) {
    console.error(`✗ Error taking screenshot: ${error.message}`);
    return false;
  } finally {
    await browser.close();
  }
}

// Parse command line arguments
const args = process.argv.slice(2);
if (args.length < 2) {
  console.error('Usage: bin/screenshot <url> <output_path> [--attach-to-pr]');
  process.exit(1);
}

const url = args[0];
const outputPath = args[1];
const attachToPr = args.includes('--attach-to-pr');

takeScreenshot(url, outputPath, attachToPr).then(success => {
  process.exit(success ? 0 : 1);
});
