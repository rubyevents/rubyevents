files: "data/**/*.yml"

pipeline:
  - directives:
      max: 1
      ensure: true

  - collection_style:
      style: block

  - sequence_indent:
      style: indented

  - quote_style:
      key_style: plain
      value_style: double

  - escapes: {}

  - final_newline:
      count: 1

rules:
  - files: "data/**/event.yml"
    pipeline:
      - schema:
          file: "lib/schemas/event_schema.json"

      - quote_style:
          selector: "description"
          value_style: literal

      - blank_lines:
          count: 0

      - delete:
          selector: "date_precision"
          condition: '.date_precision == "day"'

      - sort_keys:
          order:
            - id
            - old_ids
            - title
            - location
            - timezone
            - kind
            - frequency
            - description
            - announced_on
            - date_precision
            - pre_date
            - start_date
            - end_date
            - recordings_published_date
            - year
            - playlist
            - status
            - last_edition
            - hybrid
            - website
            - original_website
            - tickets_url
            - meetup
            - twitter
            - facebook
            - instagram
            - mastodon
            - youtube
            - github
            - luma
            - venue
            - banner_background
            - featured_background
            - featured_color
            - coordinates
            - aliases
            - youtube_channels
            - removed_talk_ids
            - feeds

      - sort_keys:
          selector: "youtube_channels[]"
          order:
            - id
            - name
            - handle
            - playlist_matcher

  - files: "data/**/involvements.yml"
    pipeline:
      - schema:
          file: "lib/schemas/involvement_schema.json"
          selector: "[]"

      - quote_style:
          selector: "[].name"
          value_style: double

      - quote_style:
          selector: "[].users"
          value_style: plain

      - quote_style:
          selector: "[].organisations"
          value_style: plain

      - blank_lines:
          selector: ""
          count: 1

  - files: "data/topics.yml"
    pipeline: []

  - files: "data/**/cfp.yml"
    pipeline:
      - schema:
          file: "lib/schemas/cfp_schema.json"
          selector: "[]"

      - quote_style:
          selector: "[].name"
          value_style: double

      - blank_lines:
          selector: ""
          count: 1

      - sort_keys:
          order:
            - name
            - link
            - open_date
            - close_date

  - files: "data/featured_cities.yml"
    pipeline:
      - schema:
          file: "lib/schemas/featured_city_schema.json"
          selector: "[]"

  - files: "data/**/sponsors.yml"
    pipeline:
      - schema:
          file: "lib/schemas/sponsors_schema.json"
          selector: "[]"

      - blank_lines:
          selector: "[].tiers"
          count: 1

      - blank_lines:
          selector: "[].tiers[].sponsors"
          count: 1

      - quote_style:
          key_style: "plain"
          value_style: "double"

  - files: "data/**/venue.yml"
    pipeline:
      - schema:
          file: "lib/schemas/venue_schema.json"

  - files: "data/**/schedule.yml"
    pipeline:
      - schema:
          file: "lib/schemas/schedule_schema.json"

      - blank_lines:
          selector: "days"
          count: 1

      - blank_lines:
          selector: "days[].grid"
          count: 1

  - files: "data/**/series.yml"
    pipeline:
      - schema:
          file: "lib/schemas/series_schema.json"

      - quote_style:
          selector: "aliases[]"
          value_style: plain

      - sort_keys:
          selector: "youtube_channels[]"
          order:
            - id
            - name
            - handle
            - playlist_matcher

      - sort_keys:
          order:
            - id
            - old_ids
            - name
            - website
            - kind
            - frequency
            - language
            - twitter
            - facebook
            - instagram
            - default_country_code
            - meetup
            - github
            - mastodon
            - original_website
            - guild
            - vimeo
            - linkedin
            - description
            - luma
            - inactive
            - bsky
            - banner_background
            - featured_background
            - featured_color
            - aliases
            - youtube_channels
            - feeds

      - sort_keys:
          path: "feeds[]"
          order:
            - type
            - url
            - name
            - handle
            - account

  - files: "data/**/videos.yml"
    pipeline:
      - sequence_indent:
          style: indented

      - schema:
          file: "lib/schemas/video_schema.json"
          selector: "[]"

      - quote_style:
          selector: "[].speakers"
          value_style: plain

      - quote_style:
          selector: "[].talks[].speakers"
          value_style: plain

      - quote_style:
          selector: "[].alternative_recordings[].speakers"
          value_style: plain

      - quote_style:
          selector: "[].talks[].alternative_recordings[].speakers"
          value_style: plain

      - quote_style:
          selector: "[].description"
          value_style: literal

      - quote_style:
          selector: "[].talks[].description"
          value_style: literal

      - blank_lines:
          selector: "[]"
          count: 0

      - blank_lines:
          selector: ""
          count: 1

      - blank_lines:
          selector: "[].talks"
          count: 1

      - blank_lines:
          selector: "[].additional_resources"
          count: 1

      - sort_keys:
          selector: "[]"
          order:
            - id
            - old_id
            - title
            - original_title
            - raw_title
            - slug
            - location
            - kind
            - event_name
            - date
            - start_time
            - end_time
            - published_at
            - announced_at
            - status
            - language
            - track
            - slides_url
            - video_provider
            - video_id
            - external_player
            - external_player_url
            - thumbnail_xs
            - thumbnail_sm
            - thumbnail_md
            - thumbnail_lg
            - thumbnail_xl
            - thumbnail_classes
            - description
            - speakers
            - talks
            - additional_resources
            - alternative_recordings

      - sort_keys:
          selector: "[].alternative_recordings[]"
          order:
            - note
            - title
            - raw_title
            - location
            - event_name
            - date
            - published_at
            - language
            - video_provider
            - video_id
            - external_url
            - description
            - speakers

      - sort_keys:
          selector: "[].talks[]"
          order:
            - id
            - old_id
            - title
            - raw_title
            - original_title
            - slug
            - location
            - kind
            - event_name
            - date
            - start_time
            - end_time
            - start_cue
            - end_cue
            - thumbnail_cue
            - published_at
            - announced_at
            - status
            - language
            - track
            - slides_url
            - video_provider
            - video_id
            - external_player
            - external_player_url
            - thumbnail_xs
            - thumbnail_sm
            - thumbnail_md
            - thumbnail_lg
            - thumbnail_xl
            - thumbnail_classes
            - description
            - speakers
            - additional_resources
            - alternative_recordings

      - sort:
          by: ".date .start_time .end_time"
          missing: keep

  - files: "data/speakers.yml"
    pipeline:
      - schema:
          file: "lib/schemas/speaker_schema.json"
          selector: "[]"

      - sort_keys:
          selector: "[]"
          order:
            - name
            - github
            - twitter
            - mastodon
            - bluesky
            - linkedin
            - website
            - speakerdeck
            - slug
            - aliases

      - sort_keys:
          selector: "[].aliases[]"
          order:
            - name
            - slug

      - sort:
          by: ".name"
