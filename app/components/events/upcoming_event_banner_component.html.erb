<a
  href="<%= helpers.event_tickets_path(upcoming_event) %>"
  data-turbo-frame="_top"
  class="
    group mt-4 flex w-full flex-row gap-8 overflow-hidden rounded-xl border px-6 py-6 transition-opacity
    duration-300 ease-in-out hover:opacity-95
  "
  style="background: <%= background_style %>; color: <%= text_color %>;"
>
  <div class="hidden aspect-video md:block">
    <%= image_tag helpers.image_path(upcoming_event.featured_image_path), alt: upcoming_event.name, class: "h-24 aspect-video rounded-xl group-hover:scale-105 transition ease-in-out duration-300" %>
  </div>

  <div class="flex w-full flex-1 flex-col self-center">
    <span class="sm:text-md text-lg font-semibold">
      <%= upcoming_event.name %> is coming up!
    </span>

    <span class="mt-1 text-sm opacity-80">
      <%= upcoming_event.location %> &bull; <%= upcoming_event.formatted_dates %>
    </span>

    <div class="mt-3">
      <span class="btn btn-sm border-0" style="background: <%= text_color %>; color: <%= background_color %>;">
        Get Tickets
      </span>
    </div>
  </div>
</a>
