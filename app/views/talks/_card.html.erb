<%# locals: (talk:, user_favorite_talks_ids: [], favoritable: false, back_to: nil, back_to_title: nil, user_watched_talks: [], watched_talks: [], show_remove_from_watched: false) %>

<% language = Language.by_code(talk.language) %>
<% watched_talk = watched_talks.find { |wt| wt.talk_id == talk.id } || user_watched_talks.find { |wt| wt.talk_id == talk.id } %>

<div
  class="talk-all talk-kind-all talk-language-all card card-compact relative w-full border bg-white talk-kind-<%= talk.kind %> talk-language-<%= talk.language %>"
  id="<%= dom_id talk %>"
  data-watched="<%= watched_talk&.watched? ? "true" : "false" %>"
>
  <% if talk.child_talks.size.positive? %>
    <div class="absolute -mt-4 ml-[10px] w-[calc(100%-20px)] rounded-xl bg-gray-300">&nbsp;</div>
    <div class="absolute -mt-2 ml-[5px] w-[calc(100%-10px)] rounded-xl bg-gray-500">&nbsp;</div>
  <% end %>

  <%= link_to talk_path(talk, back_to: back_to, back_to_title: back_to_title), class: "flex aspect-video overflow-hidden relative group", data: {action: "mouseover->preserve-scroll#updateLinkBackToWithScrollPosition", turbo_frame: "_top"} do %>
    <% if language && language != "English" %>
      <div class="absolute left-0 top-0 z-20 m-3 flex rounded-full bg-black/15 p-1 px-2 backdrop-blur-md">
        <span><%= language_to_emoji(language) %></span>
        <span class="ml-1 hidden items-center text-sm text-white lg:group-hover:flex"><%= language %></span>
      </div>
    <% end %>

    <% if talk.scheduled? || talk.parent_talk&.scheduled? %>
      <div class="absolute right-0 top-0 z-20 m-3 flex gap-2 rounded-full bg-black/15 p-2 backdrop-blur-md">
        <span class="ml-1 hidden items-center text-sm text-white lg:group-hover:flex">Scheduled</span>
        <span><%= fa("clock", size: :sm, class: "fill-white") %></span>
      </div>
    <% end %>

    <% if talk.not_published? || talk.parent_talk&.not_published? %>
      <div class="absolute right-0 top-0 z-20 m-3 flex gap-2 rounded-full bg-black/15 p-2 backdrop-blur-md">
        <span class="ml-1 hidden items-center text-sm text-white lg:group-hover:flex">Not published</span>
        <span><%= fa("upload", size: :sm, class: "fill-white") %></span>
      </div>
    <% end %>

    <% if talk.not_recorded? || talk.parent_talk&.not_recorded? %>
      <div class="absolute right-0 top-0 z-20 m-3 flex gap-2 rounded-full bg-black/15 p-2 backdrop-blur-md">
        <span class="ml-1 hidden items-center text-sm text-white lg:group-hover:flex">Not recorded</span>
        <span><%= fa("video-slash", size: :sm, class: "fill-white") %></span>
      </div>
    <% end %>

    <% if talk.video_unavailable? %>
      <div class="absolute right-0 top-0 z-20 m-3 flex gap-2 rounded-full bg-black/15 p-2 backdrop-blur-md">
        <span class="ml-1 hidden items-center text-sm text-white lg:group-hover:flex">Unavailable</span>
        <span><%= fa("video-slash", size: :sm, class: "fill-white") %></span>
      </div>
    <% end %>

    <% if talk.duration_in_seconds.present? || watched_talk&.watched? %>
      <div
        class="
          absolute bottom-0 right-0 z-20 m-3 flex items-center gap-1.5 rounded-md bg-black px-1.5 py-1 text-xs
          font-normal text-white backdrop-blur-md
        "
      >
        <% if watched_talk&.watched? %>
          <%= fa("circle-check", size: :xs, style: :solid, class: "fill-green-400") %>
        <% end %>

        <% if talk.duration_in_seconds.present? %>
          <%= seconds_to_formatted_duration(talk.duration_in_seconds) %>
        <% end %>
      </div>
    <% end %>

    <% if talk.parent_talk %>
      <div class="absolute bottom-0 left-0 z-20 m-3 flex content-center gap-2 rounded-full bg-black/15 p-2 backdrop-blur-md">
        <span><%= fa("rectangle-history", size: :sm, class: "fill-white") %></span>

        <span class="ml-1 line-clamp-1 hidden items-center gap-1 text-xs font-normal text-white lg:group-hover:inline-flex">
          <span class="text-nowrap">Part of</span>
          <span class="line-clamp-1 text-gray-300"><%= talk.parent_talk.title %></span>
        </span>
      </div>

      <% if talk.duration && talk.formatted_duration != "00:00" %>
        <div
          class="
            absolute bottom-0 right-0 z-20 m-3 flex gap-2 rounded-md bg-black px-1.5 py-1 text-xs font-normal
            text-white backdrop-blur-md
          "
        >
          <span><%= talk.formatted_duration %></span>
        </div>
      <% end %>
    <% end %>

    <% if talk.child_talks.size.positive? %>
      <div
        class="
          absolute bottom-0 right-0 z-20 m-3 flex gap-2 rounded-md bg-black px-1.5 py-1 text-xs font-normal
          text-white backdrop-blur-md
        "
      >
        <span>contains <%= pluralize(talk.child_talks.size, "talk") %></span>
      </div>
    <% end %>

    <% if watched_talk&.in_progress? %>
      <div class="absolute bottom-0 left-0 right-0 z-10">
        <div class="h-1 w-full bg-white/40">
          <div class="h-1 bg-primary" style="width: <%= watched_talk.progress_percentage.to_s %>%"></div>
        </div>
      </div>
    <% end %>

    <% if talk.published? && !watched_talk&.watched? && talk.video_available? %>
      <div class="absolute inset-0 z-10 hidden items-center justify-center rounded-t-xl bg-black/30 lg:group-hover:flex">
        <div class="rounded-full bg-gray-500 p-3 hover:bg-primary">
          <%= fa("play", size: :md, class: "fill-white") %>
        </div>
      </div>
    <% end %>

    <%= image_tag(
          talk.thumbnail_lg,
          srcset: ["#{talk.thumbnail_lg} 2x"],
          id: dom_id(talk),
          height: 174,
          width: 310,
          loading: "lazy",
          alt: "talk by #{talk.speakers.map(&:name).join(", ")}: #{talk.title}",
          style: "view-transition-name: #{dom_id(talk, :image)}",
          onload: "this.classList.remove('skeleton')",
          class: class_names(
            "w-full skeleton rounded-t-xl border-b",
            talk.thumbnail_classes.presence || "object-cover",
            "opacity-50 group-hover:opacity-75 transition-opacity": watched_talk&.watched?
          )
        ) %>
  <% end %>

  <div class="card-body flex flex-row items-start justify-between gap-2">
    <div class="flex h-full w-full flex-col items-start justify-between gap-2">
      <div class="flex w-full items-start justify-between gap-2">
        <%= link_to talk_path(talk, back_to: back_to, back_to_title: back_to_title), data: {action: "mouseover->preserve-scroll#updateLinkBackToWithScrollPosition", turbo_frame: "_top"} do %>
          <%= content_tag :h2, class: "text-sm font-sans font-medium" do %>
            <%= sanitize(talk.title_with_snippet, tags: ["mark"]) %>
          <% end %>
        <% end %>
      </div>

      <div class="flex w-full items-end justify-between gap-2">
        <div class="flex w-full flex-grow flex-col text-sm">
          <div class="flex items-center gap-2 font-light">
            <% speakers_count = talk.speakers.size %>

            <% if speakers_count > 1 %>
              <%= fa("users", size: :sm, style: :light, class: "shrink-0 grow-0 my-1") %>
            <% elsif speakers_count == 1 %>
              <%= fa("user", size: :sm, style: :regular, class: "shrink-0 grow-0 my-1") %>
            <% end %>

            <div class="line-clamp-1">
              <% talk.speakers.each do |speaker| %>
                <%= link_to speaker.name,
                      profile_path(speaker),
                      class: "link link-ghost",
                      data: {
                        turbo_frame: "_top"
                      } %>

                <% if talk.speakers.last != speaker %>
                  ,
                <% end %>
              <% end %>
            </div>
          </div>

          <% if talk.event %>
            <div class="flex items-center gap-2 font-light">
              <%= fa("location-dot", size: :sm, style: :light, class: "shrink-0 grow-0") %>

              <%= link_to talk.event_name,
                    talk.event,
                    class: "link link-ghost line-clamp-1",
                    data: {
                      turbo_frame: "_top"
                    } %>
            </div>
          <% end %>
        </div>

        <% if talk.slides_url.present? %>
          <%= ui_tooltip "Slides available" do %>
            <%= fa(
                  "presentation-screen",
                  style: :regular,
                  size: :sm,
                  class: "shrink-0 grow-0 text-black"
                ) %>
          <% end %>
        <% end %>

        <% if favoritable %>
          <div class="self-end hotwire-native:hidden">
            <% if default_watch_list %>
              <% if user_favorite_talks_ids.include?(talk.id) %>
                <%= button_to watch_list_talk_path(default_watch_list, talk.id), method: :delete, form: {class: "h-5"} do %>
                  <%= fa(
                        "bookmark",
                        style: :solid,
                        class: "text-primary shrink-0 cursor-pointer",
                        size: :sm
                      ) %>
                <% end %>
              <% else %>
                <%= button_to watch_list_talks_path(default_watch_list, talk_id: talk.id), method: :post, form: {class: "h-5"} do %>
                  <%= fa(
                        "bookmark",
                        class: "shrink-0 cursor-pointer",
                        style: :regular,
                        size: :sm
                      ) %>
                <% end %>
              <% end %>
            <% else %>
              <%= link_to new_session_path(redirect_to: request.fullpath), data: {turbo_frame: "modal"} do %>
                <%= fa(
                      "bookmark",
                      class: "shrink-0 cursor-pointer",
                      style: :regular,
                      size: :sm
                    ) %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if show_remove_from_watched && watched_talk&.watched? %>
          <div class="self-end">
            <%= button_to watched_talk_path(watched_talk), method: :delete,
                  class: "btn btn-ghost btn-sm p-1",
                  data: {turbo_confirm: "Mark this talk as unwatched? Your feedback will be deleted."} do %>
              <%= fa("xmark", size: :sm, class: "text-gray-600 shrink-0") %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
