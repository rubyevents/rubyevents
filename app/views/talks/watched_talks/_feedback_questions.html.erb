<%# locals: (talk:, watched_talk:) %>

<% update_path = talk_watched_talk_path(talk) %>
<% is_selected = ->(field, value) { watched_talk.send(field).to_s == value.to_s } %>

<div class="space-y-6">
  <div>
    <label class="mb-3 block text-sm font-medium text-gray-700">How did it make you feel?</label>

    <div class="grid grid-cols-4 gap-2 sm:grid-cols-8">
      <% WatchedTalk::FEELING_OPTIONS.each do |key, option| %>
        <% selected = watched_talk.feeling == key %>

        <%= button_to update_path, method: :patch, class: "contents", params: {watched_talk: {feeling: selected ? nil : key}} do %>
          <div class="flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 p-2 transition-colors <%= selected ? option[:selected_class] : "bg-white hover:bg-gray-50" %>">
            <%= fa(option[:emoji], size: :lg, class: "mb-1 #{"fill-white" if selected}") %>
            <span class="text-center text-xs"><%= option[:label] %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <hr class="my-4">

  <div>
    <label class="mb-3 block text-sm font-medium text-gray-700">What level of experience do you think is needed?</label>

    <div class="grid grid-cols-3 gap-2">
      <% WatchedTalk::EXPERIENCE_LEVELS.each do |key, level| %>
        <% selected = watched_talk.experience_level == key %>

        <%= button_to update_path, method: :patch, class: "contents", params: {watched_talk: {experience_level: selected ? nil : key}} do %>
          <div class="flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 p-3 transition-colors <%= selected ? "border-blue-500 bg-blue-500 text-white hover:bg-blue-600" : "bg-white hover:bg-gray-50" %>">
            <%= fa(level[:icon], size: :lg, class: "mb-1 #{"fill-white" if selected}") %>
            <span class="text-sm font-medium"><%= level[:label] %></span>
            <span class="text-xs <%= selected ? "text-blue-100" : "text-gray-500" %>"><%= level[:description] %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <hr class="my-4">

  <div>
    <label class="mb-3 block text-sm font-medium text-gray-700">How would you describe the content?</label>

    <div class="grid grid-cols-3 gap-2">
      <% WatchedTalk::CONTENT_FRESHNESS.each do |key, level| %>
        <% selected = watched_talk.content_freshness == key %>

        <%= button_to update_path, method: :patch, class: "contents", params: {watched_talk: {content_freshness: selected ? nil : key}} do %>
          <div class="flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 p-3 transition-colors <%= selected ? "border-green-500 bg-green-500 text-white hover:bg-green-600" : "bg-white hover:bg-gray-50" %>">
            <%= fa(level[:icon], size: :lg, class: "mb-1 #{"fill-white" if selected}") %>
            <span class="text-sm font-medium"><%= level[:label] %></span>
            <span class="text-xs <%= selected ? "text-green-100" : "text-gray-500" %>"><%= level[:description] %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <hr class="my-4">

  <div>
    <label class="mb-3 block text-sm font-medium text-gray-700">Feedback</label>

    <div class="space-y-3">
      <% WatchedTalk::FEEDBACK_QUESTIONS.each do |key, question| %>
        <div class="-mx-2 flex items-center justify-between rounded-lg p-2 transition-colors hover:bg-base-200">
          <span class="flex items-center gap-2 text-sm">
            <%= fa(question[:icon], size: :sm, class: "text-gray-400") %>
            <%= question[:label] %>
          </span>

          <div class="flex">
            <% yes_selected = is_selected.call(key, true) %>
            <% no_selected = is_selected.call(key, false) %>

            <%= button_to update_path, method: :patch, class: "contents", params: {watched_talk: {key => yes_selected ? nil : true}} do %>
              <div class="cursor-pointer rounded-l-lg border px-3 py-1 text-sm <%= yes_selected ? "bg-green-500 text-white border-green-500 hover:bg-green-600" : "bg-white hover:bg-green-100" %>">
                Yes
              </div>
            <% end %>

            <%= button_to update_path, method: :patch, class: "contents", params: {watched_talk: {key => no_selected ? nil : false}} do %>
              <div class="cursor-pointer rounded-r-lg border px-3 py-1 text-sm <%= no_selected ? "bg-red-500 text-white border-red-500 hover:bg-red-600" : "bg-white hover:bg-red-100" %>">
                No
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
