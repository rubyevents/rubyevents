<%# locals: (talk:, similar_talks:) %>

<div class="flex w-full min-w-0 max-w-full flex-col gap-4">
  <p class="text-sm text-gray-600">
    Similar Talks that share the same topics:
  </p>

  <div class="grid w-full max-w-full grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
    <% similar_talks.each do |similar_talk| %>
      <div class="min-w-0">
        <%= render "talks/card_thumbnail", talk: similar_talk %>
      </div>
    <% end %>
  </div>
</div>
