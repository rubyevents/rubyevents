<%# locals: (transcript:, show_hours: nil) %>

<% show_hours = transcript_shows_hours?(transcript) if show_hours.nil? %>

<div class="flex flex-col gap-1">
  <% transcript.cues.each do |cue| %>
    <% next if cue.nil? || cue.text.blank? || cue.sound_descriptor? %>

    <div
      class="flex cursor-pointer gap-4 rounded-md px-2 py-1 transition-colors hover:bg-base-300/60"
      data-transcript-target="cue"
      data-start="<%= cue.start_time_in_seconds %>"
      data-action="click->transcript#seek"
    >
      <span class="ml-2 shrink-0 self-start rounded bg-[#DEF1FF] px-1.5 font-normal tabular-nums text-[#065FD4]"><%= formatted_cue_timestamp(cue, show_hours: show_hours) %></span>
      <span><%= cue.text %></span>
    </div>
  <% end %>
</div>
