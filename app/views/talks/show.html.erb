<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="container my-8 flex w-full flex-col gap-4">
  <% back_path = params[:back_to].presence || talks_path %>
  <% back_to_title = params[:back_to_title].presence || "Talks" %>

  <div class="flex w-full">
    <div class="min-w-0 flex-grow overflow-hidden">
      <div class="flex w-full items-center justify-between hotwire-native:hidden">
        <%= link_to sanitize_url(back_path, fallback: talks_path) do %>
          <div class="title mb-4 flex items-center gap-2 text-base text-primary">
            <%= fa("arrow-left-long", class: "transition-arrow fill-primary", size: :xs) %>

            <div><%= back_to_title %></div>
          </div>
        <% end %>

        <% if (yaml_link = data_file_link_for(@talk)) %>
          <%= yaml_link %>
        <% end %>
      </div>

      <%= turbo_frame_tag "talk", target: "_top", data: {turbo_action: "advance"} do %>
        <% cache [@talk, Current.user].compact do %>
          <%= render partial: "talks/talk", locals: {talk: @talk, speakers: @speakers, user_favorite_talks_ids: @user_favorite_talks_ids, favorite_users: @favorite_users} %>
        <% end %>
      <% end %>

      <% cache @talk.event do %>
        <%= render partial: "talks/explore_event", locals: {event: @talk.event} %>
      <% end %>
    </div>

    <%= turbo_stream_from [@talk.event, :talks] %>

    <div
      class="hidden w-96 flex-shrink-0 gap-4 px-4 lg:flex lg:flex-col"
      data-turbo-permanent="true"
      id="<%= dom_id(@talk.event, :talks_wrapper) %>"
    >
      <%= link_to @talk.event.name, event_path(@talk.event), class: "pl-2 mt-8 text-neutral text-base text-lg font-bold hover:underline" %>
      <%= turbo_frame_tag dom_id(@talk.event, :talks), src: event_related_talks_path(@talk.event, active_talk: @talk), loading: "lazy" %>
    </div>
  </div>
</div>
