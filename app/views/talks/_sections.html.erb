<div class="group relative border border-transparent" id="talkToggle">
  <div class="max-h-[220px] overflow-y-hidden transition transition-all group-data-[expanded]:max-h-none">
    <div class="mb-3 grid grid-cols-1 gap-2 md:gap-4 lg:grid-cols-2">
      <% talk.child_talks.order(:start_seconds).each_with_index do |child_talk, index| %>
        <%= link_to child_talk, data: {turbo_frame: "talk"}, class: "p-2 border rounded group bg-white hover:bg-gray-100 data-[active]:border-blue-700/30 data-[active]:bg-blue-50 hover:data-[active]:bg-blue-100 data-[active]:text-blue-700", **{"data-active" => child_talk == talk}.select { |_, v| v } do %>
          <div class="flex justify-between">
            <div
              <% if child_talk == talk %>
                data-active
              <% end %>
              class="flex gap-3 text-sm text-gray-700 data-[active]:font-bold"
            >
              <div class="relative flex aspect-video w-16 shrink-0 lg:w-24 xl:w-36">
                <%= image_tag child_talk.thumbnail_sm, srcset: ["#{child_talk.thumbnail_sm} 2x"], alt: "#{child_talk.title} thumbnail", id: dom_id(child_talk), class: "w-full h-auto aspect-video rounded #{child_talk.thumbnail_classes.presence || "object-cover"}", loading: :lazy %>
              </div>

              <div class="flex flex-col justify-center gap-0.5">
                <div class="mb-1 hidden text-xs text-gray-500 xl:block">
                  Section <%= index + 1 %>
                </div>

                <div class="text-sm font-bold">
                  <%= child_talk.speakers.map(&:name).to_sentence %>
                </div>

                <div
                  class="line-clamp-2 text-sm text-gray-500 data-[active]:text-blue-700"
                  <% if child_talk == talk %>
                    data-active
                  <% end %>
                >
                  <%= child_talk.title %>

                  <% if child_talk.language_name != "English" %>
                    <span data-controller="tooltip" data-tooltip-content-value="<%= child_talk.language_name %>">
                      - <%= language_to_emoji(child_talk.language_name) %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="justify-right flex flex-col gap-2">
              <% if child_talk.start_seconds %>
                <div class="badge">
                  <%= seconds_to_formatted_duration(child_talk.start_seconds) %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if talk.child_talks.size > 4 %>
    <div
      class="
        absolute bottom-0 left-0 flex h-36 w-full items-end justify-center bg-gradient-to-t from-base-100
        to-transparent group-data-[expanded]:hidden
      "
    >
      <button class="btn-white btn btn-sm shadow" onclick="talkToggle.toggleAttribute('data-expanded')">
        Show all <%= pluralize(talk.child_talks.size, "section") %>
      </button>
    </div>
  <% end %>
</div>
