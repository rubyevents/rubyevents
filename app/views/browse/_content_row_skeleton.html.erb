<%# locals: (min_height: "252px") %>

<section class="flex animate-pulse flex-col gap-4" style="min-height: <%= min_height %>">
  <div class="flex items-end justify-between">
    <div>
      <div class="h-6 w-48 rounded bg-base-300"></div>
      <div class="mt-2 h-4 w-32 rounded bg-base-300"></div>
    </div>
  </div>

  <div class="flex gap-4 overflow-hidden">
    <% 5.times do %>
      <div class="w-[200px] shrink-0 sm:w-[300px] lg:w-[320px]">
        <div class="aspect-video rounded-lg bg-base-300"></div>

        <div class="mt-2 sm:hidden">
          <div class="h-4 w-3/4 rounded bg-base-300"></div>
          <div class="mt-1 h-3 w-1/2 rounded bg-base-300"></div>
        </div>
      </div>
    <% end %>
  </div>
</section>
