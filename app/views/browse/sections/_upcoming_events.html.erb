<%# locals: (events:) %>

<%= turbo_frame_tag "browse-upcoming-events" do %>
  <% if events&.any? %>
    <section class="group/row flex flex-col gap-4" data-section="upcoming-events">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-xl font-bold">Upcoming Events</h2>
          <p class="text-sm text-gray-500">Conferences and meetups on the horizon</p>
        </div>

        <%= link_to events_path, class: "link text-sm shrink-0 flex items-center gap-1 hover:gap-2 transition-all", data: {turbo_frame: "_top"} do %>
          View All <%= fa("arrow-right-long", size: :sm) %>
        <% end %>
      </div>

      <div class="relative" data-controller="content-row">
        <button
          class="
            absolute -left-4 top-1/2 z-10 hidden -translate-y-1/2 rounded-full bg-white p-2 opacity-0 shadow-lg
            transition-all hover:bg-gray-100 disabled:opacity-0 group-hover/row:opacity-100 lg:flex
          "
          data-content-row-target="prevButton"
          data-action="click->content-row#scrollLeft"
        >
          <%= fa("chevron-left", size: :md, class: "text-gray-700") %>
        </button>

        <div
          class="snap-x snap-mandatory overflow-x-auto scroll-smooth"
          style="-ms-overflow-style: none; scrollbar-width: none;"
          data-content-row-target="container"
          data-action="scroll->content-row#handleScroll"
        >
          <div class="flex gap-4 sm:pb-2" data-content-row-target="track">
            <% events.each do |event| %>
              <div class="w-64 shrink-0 snap-start sm:w-72">
                <%= render partial: "events/card", locals: {event: event} %>
              </div>
            <% end %>
          </div>
        </div>

        <button
          class="
            absolute -right-4 top-1/2 z-10 hidden -translate-y-1/2 rounded-full bg-white p-2 opacity-0 shadow-lg
            transition-all hover:bg-gray-100 disabled:opacity-0 group-hover/row:opacity-100 lg:flex
          "
          data-content-row-target="nextButton"
          data-action="click->content-row#scrollRight"
        >
          <%= fa("chevron-right", size: :md, class: "text-gray-700") %>
        </button>

        <div
          class="pointer-events-none absolute bottom-2 right-0 top-0 w-64 opacity-0 transition-opacity sm:opacity-50"
          style="background: linear-gradient(to left, var(--fallback-b1,oklch(var(--b1)/1)), transparent);"
          data-content-row-target="gradient"
        ></div>
      </div>
    </section>
  <% end %>
<% end %>
