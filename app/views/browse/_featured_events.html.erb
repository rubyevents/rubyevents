<%# locals: (events:) %>

<section class="mb-4 hidden md:block">
  <h2 class="mb-4 text-xl font-bold">Recently Published</h2>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    <% events.each do |event| %>
      <%= link_to event_path(event), class: "group relative rounded-xl overflow-hidden aspect-[3/2]", style: "color: #{event.static_metadata&.featured_color || "white"};" do %>
        <div class="absolute inset-0" style="background: <%= event.static_metadata&.featured_background || "black" %>;"></div>

        <div class="absolute inset-x-0 top-0 flex items-center justify-center p-4 pt-8">
          <%= image_tag event.featured_image_path, alt: event.name, class: "max-h-16 object-contain", loading: "lazy" %>
        </div>

        <div class="absolute inset-x-0 bottom-0 flex flex-col items-center p-4">
          <h3 class="line-clamp-1 text-center text-lg font-bold leading-tight group-hover:underline">
            <%= event.name %>
          </h3>

          <p class="mt-1 text-sm opacity-80">
            <%= event.location %>
          </p>

          <p class="mt-1 text-xs opacity-60">
            <%= event.talks_count %> talks

            <% if (published_date = event.static_metadata&.published_date) %>
              <span class="mx-1">&middot;</span> <%= time_ago_in_words(published_date) %> ago
            <% end %>
          </p>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
