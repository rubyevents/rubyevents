<%# locals: (min_height: "140px") %>

<section class="flex animate-pulse flex-col gap-4" style="min-height: <%= min_height %>">
  <div class="flex items-end justify-between">
    <div>
      <div class="h-6 w-48 rounded bg-base-300"></div>
      <div class="mt-2 h-4 w-32 rounded bg-base-300"></div>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <% [16, 12, 20, 14, 10, 18, 12, 16, 14, 10].each do |w| %>
      <div class="h-8 rounded-lg bg-base-300" style="width: <%= w * 4 %>px;"></div>
    <% end %>
  </div>
</section>
