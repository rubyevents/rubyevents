<div class="container py-8">
  <div class="mx-auto max-w-2xl">
    <h1 class="mb-8 text-3xl font-bold"><%= title "Account" %></h1>

    <div class="card border bg-base-100 shadow-sm">
      <div class="card-body">
        <% if Current.session %>
          <h2 class="card-title text-lg">Account</h2>
          <%= button_to "Sign out", Current.session, method: :delete, class: "btn btn-error w-full" %>
        <% else %>
          <h2 class="card-title text-lg">Sign in</h2>

          <p class="mb-4 text-sm text-gray-500">
            <strong>Sign in</strong> to bookmark talks, create watch lists, mark your speaker page as verified and more
            to come.
          </p>

          <div class="space-y-4">
            <%= render "sessions/oauth_buttons", redirect_to_path: hotwire_native_v1_oauth_path, state: nil %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
