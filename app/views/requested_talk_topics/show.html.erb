<div class="max-w-4xl mx-auto py-10">
  <h1 class="text-4xl font-bold">
    <%= @requested_talk_topic.title %>
  </h1>

  <div class="mt-6 prose">
    <%= simple_format(@requested_talk_topic.description) %>
  </div>

  <div class="mt-8 flex items-center gap-4">
    <%= button_to requested_talk_topic_vote_path(@requested_talk_topic),
          method: :post,
          class: "btn btn-outline" do %>
      <%= fa("arrow-up", size: :sm) %>
      Vote
    <% end %>

    <span>
      <%= pluralize(@requested_talk_topic.votes_count, "vote") %>
    </span>
  </div>

</div>
