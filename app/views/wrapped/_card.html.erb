<section class="w-full">
  <%= link_to wrapped_path, class: "block w-full p-6 lg:p-10 rounded-[10px] lg:rounded-[25px] bg-gradient-to-br from-red-600 to-red-800 text-white hover:from-red-700 hover:to-red-900 transition-all shadow-lg hover:shadow-xl" do %>
    <div class="flex flex-col items-center gap-6 lg:flex-row lg:gap-10">
      <div class="flex-shrink-0">
        <div class="flex h-24 w-24 items-center justify-center rounded-2xl bg-white/10 lg:h-32 lg:w-32">
          <svg class="h-16 w-16 text-white lg:h-20 lg:w-20" viewBox="0 0 80 80" fill="currentColor">
            <path d="M2 25 L16 10 L64 10 L78 25 L40 70 Z" />
          </svg>
        </div>
      </div>

      <div class="flex-1 text-center lg:text-left">
        <p class="mb-1 text-sm font-medium text-red-200">RubyEvents.org</p>
        <h2 class="mb-2 text-3xl font-black lg:text-4xl">2025 Wrapped</h2>

        <p class="max-w-xl text-base text-red-100 lg:text-lg">
          Discover your year in Ruby events. See your watching stats, top speakers, events attended, and more!
        </p>
      </div>

      <div class="flex-shrink-0">
        <span
          class="
            inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 font-semibold text-red-700 transition
            hover:bg-red-50
          "
        >
          View Your 2025 Wrapped
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </div>
  <% end %>
</section>
