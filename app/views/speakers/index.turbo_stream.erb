<%= turbo_stream.append "speakers" do %>
  <%= render "speakers/list", speakers: @speakers, activities: @activity %>
<% end %>

<% if @pagy.next.present? %>
  <%= turbo_stream.replace "pagination" do %>
    <%= turbo_frame_tag :pagination, data: {controller: "lazy-loading", lazy_loading_src_value: speakers_path(letter: params[:letter], s: params[:s], sort: (@sort unless @sort == "name"), page: @pagy.next, format: :turbo_stream)} %>
  <% end %>
<% end %>
