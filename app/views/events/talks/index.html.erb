<%= render partial: "events/header", locals: {event: @event} %>

<%= turbo_frame_tag dom_id(@event), data: {turbo_action: "advance", turbo_frame: "_top"} do %>
  <div class="container py-8" data-controller="talks-filter">
    <%= render partial: "events/navigation", locals: {event: @event} %>
    <%= render partial: "talks/talk_filter", locals: {talks: @talks} %>

    <div class="flex w-full flex-wrap items-start gap-8 sm:flex-nowrap">
      <div class="w-full">
        <% if @talks.any? %>
          <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <h2>Talks (<%= @talks.size %>)</h2>

            <% if Current.user %>
              <label class="flex cursor-pointer items-center gap-2">
                <input
                  type="checkbox"
                  class="checkbox checkbox-sm"
                  data-action="change->talks-filter#toggle"
                  data-talks-filter-target="toggle"
                >

                <span class="text-sm">Hide watched</span>
                <span class="hidden text-sm text-gray-500">(<span data-talks-filter-target="count">0</span> hidden)</span>
              </label>
            <% end %>
          </div>
        <% end %>

        <div id="talks" class="grid h-full min-w-full grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <%= render partial: "talks/card",
                collection: @talks,
                locals: {
                  favoritable: true,
                  user_favorite_talks_ids: @user_favorite_talks_ids,
                  user_watched_talks: user_watched_talks,
                  back_to: back_to_from_request,
                  back_to_title: @event.name
                },
                as: :talk %>
        </div>

        <% if @talks.empty? %>
          <div class="py-12 text-center">
            <div class="mx-auto max-w-md">
              <div class="mb-4 text-6xl">🎤</div>
              <h2 class="mb-4 text-2xl font-bold text-gray-900">No Talks Yet</h2>

              <p class="mb-6 text-gray-600">
                Help us make this information complete! Do you have recordings or information about talks from
                <%= @event.name %>?
              </p>

              <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-left">
                <h3 class="mb-2 font-semibold text-amber-800">How to contribute:</h3>

                <ul class="space-y-1 text-sm text-amber-700">
                  <li>• Check if recordings are available online</li>
                  <li>• Look for talk abstracts and speaker information</li>

                  <li>
                    <a href="https://github.com/rubyevents/rubyevents/issues/new?title=<%= CGI.escape("#{@event.name} Recordings") %>&body=<%= CGI.escape("<!-- Your Content Here -->\n\nIssue opened from event page: #{event_url(@event)}") %>" class="underline hover:text-amber-900" target="_blank"> • Open an issue on GitHub </a>
                    to report available recordings
                  </li>

                  <li>
                    <a
                      href="https://github.com/rubyevents/rubyevents/blob/main/docs/ADDING_VIDEOS.md"
                      class="underline hover:text-amber-900"
                      target="_blank"
                    >
                      • Submit talk data via GitHub
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
