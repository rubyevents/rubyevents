<%= render partial: "events/header", locals: {event: @event, participation: nil} %>

<%= turbo_frame_tag dom_id(@event), data: {turbo_action: "advance", turbo_frame: "_top"} do %>
  <div class="container py-8">
    <%= render partial: "events/navigation", locals: {event: @event} %>

    <div class="mt-8 flex flex-col gap-12">
      <% if @stamps.any? %>
        <section class="rounded-lg border bg-white p-6 shadow-sm">
          <div class="mb-6">
            <h2 class="mb-2 text-2xl font-bold text-gray-900">Stamps</h2>

            <p class="text-gray-600">
              Collect stamps by attending <%= @event.name %>.
            </p>
          </div>

          <%= render partial: "shared/stamps_grid", locals: {stamps: @stamps, min_rows: 1} %>
        </section>
      <% end %>

      <% if @stickers.any? %>
        <section class="rounded-lg border border-gray-300 bg-gradient-to-b from-gray-400 via-gray-500 to-gray-600 p-6 shadow-sm">
          <div class="mb-6">
            <h2 class="mb-2 text-2xl font-bold text-white">Stickers</h2>

            <p class="text-gray-200">
              Available stickers for <%= @event.name %>.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
            <% @stickers.each do |sticker| %>
              <div
                class="
                  group relative rounded-lg border border-white/20 bg-white/10 p-4 backdrop-blur-sm
                  transition-colors hover:bg-white/20
                "
              >
                <div class="mb-2 flex aspect-square items-center justify-center">
                  <%= image_tag sticker.asset_path, class: "max-w-full max-h-full object-contain group-hover:scale-110 transition-transform", alt: sticker.name %>
                </div>

                <p class="truncate text-center text-xs text-white"><%= sticker.name %></p>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @stamps.empty? && @stickers.empty? %>
        <div class="py-12 text-center">
          <div class="mx-auto max-w-md">
            <div class="mb-4 text-6xl">🎨</div>
            <h2 class="mb-4 text-2xl font-bold text-gray-900">No Collectibles Yet</h2>

            <p class="mb-6 text-gray-600">
              There are no stamps or stickers available for <%= @event.name %> yet.
            </p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
