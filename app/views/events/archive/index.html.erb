<div class="container py-8 hotwire-native:mb-6">
  <div class="hotwire-native:hidden">
    <h1 class="title">
      <%= title "Events Archive" %>

      <span class="text-base text-gray-500">
        (<%= pluralize(@events.includes(:series).where(series: {kind: "conference"}).count, "conference") %>,
        <%= pluralize(@events.includes(:series).where(series: {kind: "meetup"}).count, "meetup") %>,
        <%= pluralize(@events.includes(:series).where(series: {kind: "hackathon"}).count, "hackathon") %>,
        <%= pluralize(@events.includes(:series).where(series: {kind: "workshop"}).count, "workshop") %>,
        <%= pluralize(@events.includes(:series).where(series: {kind: "retreat"}).count, "retreat") %>)
      </span>
    </h1>

    <div
      class="
        mt-2 flex flex-col gap-3 md:flex-row md:items-stretch md:justify-between md:gap-4 md:border-b
        md:border-gray-200
      "
    >
      <%= render "events/collections_navigation", active: :archive %>

      <div class="flex shrink-0 items-center overflow-x-auto pb-2 md:pb-1">
        <div class="tabs-boxed tabs">
          <%= link_to "All", archive_events_path(kind: "all", letter: params[:letter]), class: "tab #{"tab-active" if params[:kind].blank? || params[:kind] == "all"}" %>
          <%= link_to "Conferences", archive_events_path(kind: "conference", letter: params[:letter]), class: "tab #{"tab-active" if params[:kind] == "conference"}" %>
          <%= link_to "Meetups", archive_events_path(kind: "meetup", letter: params[:letter]), class: "tab #{"tab-active" if params[:kind] == "meetup"}" %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex w-full flex-wrap justify-between gap-1 py-8 hotwire-native:hidden">
    <%= link_to archive_events_path(kind: params[:kind]), class: class_names("flex items-center justify-center w-10 text-gray-500 rounded hover:bg-brand-lighter border", "bg-brand-lighter": params[:letter].blank?) do %>
      all
    <% end %>

    <% ("a".."z").each do |letter| %>
      <%= link_to archive_events_path(letter: letter, kind: params[:kind]), id: letter, class: class_names("flex items-center justify-center w-10 text-gray-500 rounded hover:bg-brand-lighter border", "bg-brand-lighter": letter == params[:letter]) do %>
        <%= letter.upcase %>
      <% end %>
    <% end %>
  </div>

  <% if params[:letter].present? %>
    <div class="mb-12 font-medium">
      Events starting with "<%= params[:letter].upcase %>"
    </div>
  <% end %>

  <% if params[:s].present? %>
    <div class="mb-12 font-medium">
      search results for "<%= params[:s] %>"
    </div>
  <% end %>

  <% if @events.any? %>
    <% @events.group_by(&:series).each do |series, events| %>
      <h2><%= link_to series.name, series_path(series) %></h2>

      <div
        id="<%= dom_id(series, "events") %>"
        class="grid min-w-full gap-x-8 gap-y-2 pb-8 pt-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-12 xl:grid-cols-4"
      >
        <%= render partial: "events/event", collection: events %>
      </div>
    <% end %>
  <% else %>
    <p>No events found</p>
  <% end %>
</div>
