<%= render partial: "events/header", locals: {event: @event, participation: @participation} %>

<%= turbo_frame_tag dom_id(@event), data: {turbo_action: "advance", turbo_frame: "_top"} do %>
  <div class="container py-8">
    <%= render partial: "events/navigation", locals: {event: @event} %>

    <div class="flex w-full flex-wrap items-start gap-8 sm:flex-nowrap">
      <div class="w-full">
        <% if @event.meetup? && @speakers_with_counts %>
          <h2 class="mb-6">Speakers (<%= @speakers_with_counts.size %>)</h2>

          <div class="mb-12 grid h-full min-w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <% @speakers_with_counts.each do |speaker| %>
              <div class="transition-bg relative rounded-lg border bg-white duration-300 ease-in-out hover:bg-gray-200">
                <% if speaker.meetup_talks_count > 1 %>
                  <div class="absolute right-2 top-2 rounded-full bg-primary px-2 py-1 text-xs font-semibold text-white">
                    <%= speaker.meetup_talks_count %> talks
                  </div>
                <% end %>

                <%= render partial: "users/card", locals: {user: speaker} %>
              </div>
            <% end %>
          </div>
        <% else %>
          <% titles = Talk.speaker_role_titles %>

          <% grouped = @event.talks.flat_map { |talk| talk.speakers.map { |speaker| [talk.kind, speaker] } }.group_by(&:first).transform_values(&:uniq).sort_by { |kind, _speakers| Talk.kinds.values.index(kind) } %>

          <% grouped.each do |kind, speakers| %>
            <h2 class="mb-6"><%= titles[kind.to_sym].pluralize(speakers.count) %></h2>

            <div
              id="keynote-speakers"
              class="mb-12 grid h-full min-w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
            >
              <% speakers.each do |kind, speaker| %>
                <div class="transition-bg rounded-lg border bg-white duration-300 ease-in-out hover:bg-gray-200">
                  <%= render partial: "users/card", locals: {user: speaker} %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
