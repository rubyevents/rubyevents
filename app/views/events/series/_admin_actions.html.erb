<%# locals: (series:) %>

<% if Current.user&.admin? %>
  <div class="mt-4 flex items-center gap-2 border-t border-gray-200 pt-4">
    <span class="text-xs uppercase tracking-wide text-gray-400">Admin</span>

    <%= ui_tooltip "Reimport Series" do %>
      <%= ui_button url: reimport_series_path(series), method: :post, kind: :neutral, size: :sm do %>
        <%= fa "download", size: :sm %>
      <% end %>
    <% end %>

    <%= ui_tooltip "Reindex Series" do %>
      <%= ui_button url: reindex_series_path(series), method: :post, kind: :neutral, size: :sm do %>
        <%= fa "arrows-rotate", size: :sm %>
      <% end %>
    <% end %>

    <%= ui_tooltip "Open in Avo" do %>
      <%= ui_button url: avo.resources_event_series_path(series), target: :_blank, kind: :neutral, size: :sm do %>
        <%= fa :avocado, size: :sm %>
      <% end %>
    <% end %>
  </div>
<% end %>
