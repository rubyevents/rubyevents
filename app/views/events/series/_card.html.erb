<%= link_to series_path(series), class: "flex w-full" do %>
  <div class="card h-full w-full border">
    <div class="card-body flex flex-col items-center justify-center">
      <div class="text-center text-xl font-semibold"><%= series.name %></div>
      <div><%= pluralize(series.events.count, "event") %></div>
    </div>
  </div>
<% end %>
