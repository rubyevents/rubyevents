<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="container py-8">
  <%= render "events/series/breadcrumbs", series: @event_series %>

  <div class="align-center block justify-between gap-8 lg:flex">
    <div class="lg:justify-right mb-6 flex flex-col items-center gap-8 text-center lg:mb-0 lg:flex-row lg:text-left">
      <% if (avatar_image_path = @events.first&.avatar_image_path || (@event_series.avatar_image_path if @event_series.static_metadata.default_image("avatar.webp"))) %>
        <%= image_tag image_path(avatar_image_path),
              class: "rounded-full border border-[#D9DFE3] size-24 md:size-36",
              alt: "#{@event_series.name} Avatar",
              loading: :lazy %>
      <% end %>

      <div class="flex flex-col justify-center">
        <h1 class="mb-2 font-bold text-black"><%= @event_series.name %></h1>

        <h3 class="hidden text-[#636B74] md:block">
          <%= pluralize(@event_series.events.count, "event") %>

          <% if @event_series.static_metadata&.all_youtube_channels&.any? %>
            -
            <%= @event_series.static_metadata.all_youtube_channels.filter_map { |c| c["handle"].presence || c["name"].presence }.join(", ") %>
          <% end %>
        </h3>

        <%= render Ui::SocialLinksComponent.new(@event_series.static_metadata) %>
      </div>
    </div>

    <div class="flex items-center gap-2 mb-6 lg:mb-0">
      <%= render partial: "events/series/follow_button", locals: {event_series: @event_series, subscription: @subscription} %>
    </div>

    <%= render "events/series/admin_actions", series: @event_series %>

    <% if (yaml_link = data_file_link_for(@event_series)) %>
      <div class="mt-4"><%= yaml_link %></div>
    <% end %>
  </div>

  <p class="mb-3 mt-3 max-w-[700px] text-[#636B74] md:mt-9">
    <%= @event_series.description %>
  </p>

  <% if @event_series.inactive? %>
    <div class="-mt-0.5 mb-4 flex text-gray-400">
      <%= fa "box-archive", size: :xs, class: "mt-0.5 fill-gray-400" %>
      <span class="ml-0.5 mt-0.5 text-sm">This event series is not active anymore.</span>
    </div>
  <% end %>

  <% if (featured_event = @other_events.find { |event| event.featurable? }) %>
    <div class="hidden lg:block">
      <%= render partial: "events/featured", locals: {event: featured_event} %>
    </div>
  <% end %>

  <% if @series_cfps.any? %>
    <div id="series-cfps" class="mt-12">
      <h2 class="mb-4 text-primary">Call for Proposals</h2>

      <div class="flex flex-col gap-2">
        <% @series_cfps.each do |cfp| %>
          <%= link_to cfp.link, target: "_blank", rel: "noopener", class: "flex items-center justify-between gap-4 rounded-lg border bg-white px-4 py-3 hover:bg-gray-200" do %>
            <span class="font-medium"><%= cfp.name.presence || "Call for Proposals" %></span>
            <span class="text-sm text-gray-500"><%= cfp.open_ended? ? "Always open" : "Closes #{l(cfp.close_date, format: :medium)}" %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "events/series/involvements", involvements: @organizers, sponsors: @series_sponsors %>

  <% if @child_series.any? %>
    <div id="child-series" class="mt-12">
      <h2 class="mb-4 text-primary">Series</h2>

      <div class="grid min-w-full grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        <% @child_series.each do |child| %>
          <% if child.meetup? %>
            <%= render "events/series/meetup_card", series: child %>
          <% else %>
            <%= render "events/series/card", series: child %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @other_events.any? %>
    <div id="events" class="mt-12">
      <section class="flex w-full flex-col gap-4">
        <div class="flex w-full items-center justify-between">
          <h2 class="shrink-0 text-primary">Events</h2>
        </div>

        <div class="grid min-w-full grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          <%= cache @other_events do %>
            <%= render partial: "events/card", collection: @other_events, as: :event, cached: true %>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>

  <%= render "events/series/todos", todos: @todos %>
</div>
