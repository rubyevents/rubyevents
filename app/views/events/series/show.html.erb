<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="container py-8">
  <div class="align-center block justify-between gap-8 lg:flex">
    <div class="lg:justify-right mb-6 flex flex-col items-center gap-8 text-center lg:mb-0 lg:flex-row lg:text-left">
      <% if @events.first&.avatar_image_path %>
        <%= image_tag image_path(@events.first&.avatar_image_path),
              class: "rounded-full border border-[#D9DFE3] size-24 md:size-36",
              alt: "#{@event_series.name} Avatar",
              loading: :lazy %>
      <% end %>

      <div class="flex flex-col justify-center">
        <h1 class="mb-2 font-bold text-black"><%= @event_series.name %></h1>

        <h3 class="hidden text-[#636B74] md:block">
          <%= pluralize(@event_series.events.count, "event") %>

          <% if @event_series.static_metadata&.all_youtube_channels&.any? %>
            -
            <%= @event_series.static_metadata.all_youtube_channels.filter_map { |c| c["handle"].presence || c["name"].presence }.join(", ") %>
          <% end %>
        </h3>
      </div>
    </div>

    <div class="flex items-center gap-2 mb-6 lg:mb-0">
      <%= render partial: "events/series/follow_button", locals: {event_series: @event_series, subscription: @subscription} %>
    </div>

    <% if Current.user&.admin? %>
      <div class="mt-4 flex items-center gap-2 border-t border-gray-200 pt-4">
        <span class="text-xs uppercase tracking-wide text-gray-400">Admin</span>

        <%= ui_tooltip "Reimport Series" do %>
          <%= ui_button url: reimport_series_path(@event_series), method: :post, kind: :neutral, size: :sm do %>
            <%= fa "download", size: :sm %>
          <% end %>
        <% end %>

        <%= ui_tooltip "Reindex Series" do %>
          <%= ui_button url: reindex_series_path(@event_series), method: :post, kind: :neutral, size: :sm do %>
            <%= fa "arrows-rotate", size: :sm %>
          <% end %>
        <% end %>

        <%= ui_tooltip "Open in Avo" do %>
          <%= ui_button url: avo.resources_event_series_path(@event_series), target: :_blank, kind: :neutral, size: :sm do %>
            <%= fa :avocado, size: :sm %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if (yaml_link = data_file_link_for(@event_series)) %>
      <div class="mt-4"><%= yaml_link %></div>
    <% end %>
  </div>

  <p class="mb-3 mt-3 max-w-[700px] text-[#636B74] md:mt-9">
    <%= @event_series.description %>
  </p>

  <% if @event_series.static_metadata&.ended? %>
    <div class="-mt-0.5 mb-4 flex text-gray-400">
      <%= fa "box-archive", size: :xs, class: "mt-0.5 fill-gray-400" %>
      <span class="ml-0.5 mt-0.5 text-sm">This event series is not active anymore.</span>
    </div>
  <% end %>

  <% if (featured_event = @events.find { |event| event.featurable? }) %>
    <div class="hidden lg:block">
      <%= render partial: "events/featured", locals: {event: featured_event} %>
    </div>
  <% end %>

  <% if @events.any? %>
    <div id="events" class="mt-12">
      <section class="flex w-full flex-col gap-4">
        <div class="flex w-full items-center justify-between">
          <h2 class="shrink-0 text-primary">Events</h2>
        </div>

        <div class="grid min-w-full grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          <%= cache @events do %>
            <%= render partial: "events/card", collection: @events, as: :event, cached: true %>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>

  <% if @todos.any? %>
    <div id="todos" class="mt-12">
      <section class="flex w-full flex-col gap-4">
        <div class="flex w-full items-center justify-between">
          <h2 class="shrink-0 text-primary">TODOs</h2>
          <span class="badge badge-primary"><%= @todos.size %></span>
        </div>

        <div class="card bg-base-200">
          <div class="card-body p-4">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Location</th>
                  <th>Content</th>
                </tr>
              </thead>

              <tbody>
                <% @todos.first(20).each do |todo| %>
                  <tr>
                    <td class="font-mono text-xs">
                      <%= link_to todo.url, target: "_blank", class: "link link-primary" do %>
                        <%= todo.file.split("/").last(2).join("/") %>:<%= todo.line %>
                      <% end %>
                    </td>

                    <td><code class="break-all text-xs"><%= todo.content %></code></td>
                  </tr>
                <% end %>
              </tbody>
            </table>

            <% if @todos.size > 20 %>
              <p class="mt-2 text-sm text-base-content/70">
                ... and <%= @todos.size - 20 %> more.
                <%= link_to "View all TODOs", todos_path(view: "by_event"), class: "link link-primary" %>
              </p>
            <% end %>
          </div>
        </div>
      </section>
    </div>
  <% end %>
</div>
