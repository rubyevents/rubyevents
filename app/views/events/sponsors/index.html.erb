<%= render partial: "events/header", locals: {event: @event} %>

<%= turbo_frame_tag dom_id(@event), data: {turbo_action: "advance", turbo_frame: "_top"} do %>
  <div class="container py-8">
    <%= render partial: "events/navigation", locals: {event: @event} %>

    <% if @sponsors_by_tier.any? %>
      <% @sponsors_by_tier.each do |tier, sponsors| %>
        <div>
          <h2 class="mb-6 capitalize">
            <%= tier %>
          </h2>

          <div class="mb-12 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
            <% sponsors.each do |sponsor| %>
              <%= render "organizations/card", organization: sponsor.organization, sponsor: sponsor, turbo_frame: true, grid_layout: true, hide_event_count: true %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="py-12 text-center">
        <div class="mx-auto max-w-md">
          <div class="mb-4 text-6xl">🤝</div>
          <h2 class="mb-4 text-2xl font-bold text-gray-900">No Sponsors Yet</h2>

          <p class="mb-6 text-gray-600">
            Help us make this information complete! Do you know who sponsored <%= @event.name %>?
          </p>

          <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-left">
            <h3 class="mb-2 font-semibold text-amber-800">How to contribute:</h3>

            <ul class="space-y-1 text-sm text-amber-700">
              <li>• Check the event website or program</li>
              <li>• Look for sponsor logos in videos or photos</li>

              <li>
                <a
                  href="https://github.com/rubyevents/rubyevents/blob/main/docs/ADDING_SPONSORS.md"
                  class="underline hover:text-amber-900"
                  target="_blank"
                >
                  • Submit sponsor data via GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
