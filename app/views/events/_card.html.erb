<%# locals: (event:, participation: nil, checked_in: false) %>

<%= link_to event_path(event), class: "flex w-full", data: {turbo_frame: "_top"} do %>
  <div class="card card-compact w-full border bg-white <% if event.static_metadata.cancelled? %> opacity-50 grayscale <% end %>">
    <%= image_tag image_path(event.card_image_path), class: "w-full object-cover rounded-t-xl border-b", alt: event.name, width: 300, height: 175 %>

    <div class="card-body flex min-h-[130px] flex-col items-center justify-center">
      <div class="line-clamp-1 text-center text-xl font-semibold <% if event.static_metadata.cancelled? %> line-through <% end %>">
        <%= event.name %>
      </div>

      <div class="flex flex-col items-center text-center text-gray-500">
        <span><%= event.to_location.to_html(show_links: false) %></span>
        <span class="mt-1"><%= event.formatted_dates %></span>

        <% if participation.present? || checked_in %>
          <div class="mt-2 flex items-center justify-center gap-1.5">
            <% if participation.present? %>
              <%= ui_badge(participation.attended_as.humanize, size: :sm, class: "bg-blue-700 border-blue-700") %>
            <% elsif checked_in %>
              <%= ui_badge("Visitor", size: :sm, class: "bg-blue-700 border-blue-700") %>
            <% end %>

            <% if checked_in %>
              <%= render "shared/checked_in_badge" %>
            <% end %>
          </div>
        <% end %>

        <% if event.static_metadata.cancelled? %>
          <div class="mt-2 flex items-center justify-center text-red-500">
            <%= fa "circle-xmark", size: :xs, style: :regular, class: "fill-red-500" %>
            <span class="ml-1 mt-0.5 text-sm">Cancelled</span>
          </div>
        <% end %>

        <% if event.static_metadata.last_edition? %>
          <div class="mt-2 flex items-center justify-center text-gray-400">
            <%= fa "box-archive", size: :xs, style: :regular, class: "fill-gray-400" %>
            <span class="ml-1 mt-0.5 text-sm">Final Edition</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
