<%= render layout: "shared/library_layout" do %>
  <div class="mb-8">
    <h1 class="mb-2 text-3xl font-bold text-primary">My Attendances</h1>
    <p class="text-gray-600">Track which talks you attended in-person at events you participated in.</p>
  </div>

  <% if @events.empty? %>
    <div class="rounded-lg border bg-white py-12 text-center">
      <div class="mb-4 text-6xl">🎟️</div>

      <h2 class="mb-2 text-xl font-bold text-gray-900">No Past Events</h2>

      <p class="mb-6 text-gray-600">
        You haven't participated in any past events yet. Mark your attendance at events to start tracking your
        conference history.
      </p>

      <%= link_to "Browse Events", events_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <div class="space-y-8">
      <% @events_by_year.each do |year, events| %>
        <section>
          <h2 class="mb-4 border-b pb-2 text-xl font-bold text-gray-700"><%= year %></h2>

          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <% events.each do |event| %>
              <% stats = @attendance_stats[event.id] || {in_person: 0, online: 0} %>
              <% total_talks = event.talks.count %>
              <% watched_total = stats[:in_person] + stats[:online] %>
              <% unwatched = [total_talks - watched_total, 0].max %>

              <div class="overflow-hidden rounded-lg border bg-white shadow-sm transition-shadow hover:shadow-md">
                <div
                  class="flex h-24 items-center justify-center overflow-hidden"
                  style="<% if event.static_metadata.banner_background.start_with?('data:') %>background: url('<%= event.static_metadata.banner_background %>'); background-repeat: no-repeat; background-size: cover;<% else %>background: <%= event.static_metadata.banner_background %>;<% end %>"
                >
                  <%= image_tag image_path(event.banner_image_path), alt: event.name, class: "h-full w-full object-cover" %>
                </div>

                <div class="p-4">
                  <h3 class="mb-1 text-lg font-bold">
                    <%= link_to event.name, event_path(event), class: "hover:text-primary" %>
                  </h3>

                  <p class="mb-3 text-sm text-gray-500">
                    <%= event.formatted_dates %>
                  </p>

                  <div class="mb-4 flex items-center gap-4 text-sm">
                    <div class="flex items-center gap-1">
                      <%= fa("user-check", size: :sm, class: "fill-green-600") %>
                      <span class="font-medium text-green-700"><%= stats[:in_person] %></span>
                      <span class="text-gray-500">in-person</span>
                    </div>

                    <div class="flex items-center gap-1">
                      <%= fa("video", size: :sm, class: "fill-blue-600") %>
                      <span class="font-medium text-blue-700"><%= stats[:online] %></span>
                      <span class="text-gray-500">online</span>
                    </div>

                    <div class="flex items-center gap-1">
                      <%= fa("circle", size: :sm, style: :regular, class: "text-gray-400") %>
                      <span class="text-gray-500"><%= unwatched %></span>
                      <span class="text-gray-400">left</span>
                    </div>
                  </div>

                  <% if total_talks > 0 %>
                    <div class="mb-3 h-2 w-full rounded-full bg-gray-200">
                      <% in_person_percent = (stats[:in_person].to_f / total_talks * 100).round %>
                      <% online_percent = (stats[:online].to_f / total_talks * 100).round %>

                      <div class="flex h-2 overflow-hidden rounded-full">
                        <div class="bg-green-500" style="width: <%= in_person_percent %>%"></div>
                        <div class="bg-blue-500" style="width: <%= online_percent %>%"></div>
                      </div>
                    </div>
                  <% end %>

                  <% if event.talks.any? %>
                    <%= link_to attendance_path(event_slug: event.slug), class: "btn btn-sm btn-outline w-full" do %>
                      <%= fa("pen-to-square", size: :sm) %> Manage Attendance
                    <% end %>
                  <% else %>
                    <div class="py-2 text-center text-xs text-gray-400">
                      No talks available
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
<% end %>
