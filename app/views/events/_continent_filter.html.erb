<%# locals: (label:, path:, active: false) %>
<%= link_to label,
      path,
      class: class_names(
        "tab whitespace-nowrap max-md:h-auto max-md:min-h-6 max-md:rounded-lg max-md:px-2.5 max-md:py-1 max-md:text-xs max-md:leading-tight",
        "tab-active" => active
      ),
      aria: {current: active ? "page" : nil} %>
