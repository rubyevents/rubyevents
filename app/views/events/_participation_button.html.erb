<% event_status = event.start_date&.future? ? "upcoming" : "past" %>
<% tooltip_text = t("event_participation.tooltips.#{event_status}") %>

<div class="participation_button mt-4 space-y-2">
  <% if Current.user %>
    <% if participation&.attendee? %>
      <%= ui_tooltip t("event_participation.actions.remove_participation") do %>
        <%= ui_button url: event_event_participation_path(event, participation), params: {role: "attendee"}, method: :delete, kind: :neutral, size: :sm, class: "w-full", data: {turbo_frame: "modal"} do %>
          <%= fa("circle-check", size: :xs, style: :solid, class: "fill-green-700") %>

          <span class="text-nowrap">
            <%= t("event_participation.#{event_status}.role.attendee") %>
          </span>
        <% end %>
      <% end %>

      <%= ui_tooltip t("event_participation.tooltips.interested") do %>
        <%= ui_button url: event_event_participations_path(event), params: {role: "interested"}, method: :post, outline: true, size: :sm, kind: :neutral, class: "w-full", data: {turbo_frame: "modal"} do %>
          <%= fa("bookmark", size: :xs, style: :regular) %>
          <span class="text-nowrap"><%= t("event_participation.actions.mark_as_interested") %></span>
        <% end %>
      <% end %>
    <% elsif participation&.interested? %>
      <%= ui_tooltip t("event_participation.actions.remove_interest") do %>
        <%= ui_button url: event_event_participation_path(event, participation), params: {role: "interested"}, method: :delete, kind: :neutral, size: :sm, class: "w-full", data: {turbo_frame: "modal"} do %>
          <%= fa("bookmark", size: :xs, style: :solid, class: "fill-amber-600") %>

          <span class="text-nowrap">
            <%= t("event_participation.#{event_status}.role.interested") %>
          </span>
        <% end %>
      <% end %>

      <%= ui_tooltip tooltip_text do %>
        <%= ui_button url: event_event_participations_path(event), params: {role: "attendee"}, method: :post, outline: true, size: :sm, kind: :neutral, class: "w-full", data: {turbo_frame: "modal"} do %>
          <%= fa("plus", size: :xs, style: :solid) %>
          <span class="text-nowrap"><%= t("event_participation.actions.mark_as_going") %></span>
        <% end %>
      <% end %>
    <% elsif participation %>
      <%= ui_button kind: :neutral, size: :sm, class: "w-full", disabled: true do %>
        <%= fa("circle-check", size: :xs, style: :solid, class: "fill-green-700") %>

        <span class="text-nowrap">
          <%= t("event_participation.#{event_status}.role.speaker") %>
        </span>
      <% end %>
    <% else %>
      <%= ui_tooltip tooltip_text do %>
        <%= ui_button url: event_event_participations_path(event), params: {role: "attendee"}, method: :post, outline: true, size: :sm, kind: :neutral, class: "w-full", data: {turbo_frame: "modal"} do %>
          <%= fa("plus", style: :solid, size: :sm) %>
          <span class="text-nowrap"><%= t("event_participation.actions.going") %></span>
        <% end %>
      <% end %>

      <%= ui_tooltip t("event_participation.tooltips.interested") do %>
        <%= ui_button url: event_event_participations_path(event), params: {role: "interested"}, method: :post, outline: true, size: :sm, kind: :neutral, class: "w-full", data: {turbo_frame: "modal"} do %>
          <%= fa("bookmark", style: :regular, size: :sm) %>
          <span class="text-nowrap"><%= t("event_participation.actions.interested") %></span>
        <% end %>
      <% end %>
    <% end %>

    <% if defined?(errors) && errors&.any? %>
      <div class="mt-2 text-sm text-red-600">
        <% errors.full_messages.each do |message| %>
          <div><%= message %></div>
        <% end %>
      </div>
    <% end %>

    <% event_is_past = event.end_date.present? && event.end_date < Date.today %>

    <% if participation&.attending? && event_is_past && event.talks.any? %>
      <%= link_to attendance_path(event_slug: event.slug), class: "btn btn-sm btn-outline w-full mt-2" do %>
        <%= fa("clipboard-check", size: :sm) %>
        <span class="text-nowrap">Manage My Attendance</span>
      <% end %>
    <% end %>
  <% else %>
    <%= ui_tooltip tooltip_text do %>
      <%= ui_button url: new_session_path(redirect_to: request.fullpath), outline: true, size: :sm, kind: :neutral, class: "w-full", data: {turbo_frame: "modal"} do %>
        <%= fa("plus", style: :solid) %>
        <span class="text-nowrap"><%= t("event_participation.actions.add_to_my_events") %></span>
      <% end %>
    <% end %>
  <% end %>
</div>
