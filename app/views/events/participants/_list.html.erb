<%# locals: (event:, participants:, participation:, favorite_users:, checked_in_participant_ids: Set.new, unclaimed_check_ins_count: 0) %>

<% button_text = event.start_date&.future? ? "Are you going?" : "Were you there?" %>
<% event_stamp = Stamp.for_event(event).first %>

<div id="participants_list">
  <% if unclaimed_check_ins_count > 0 %>
    <div class="mb-6 flex items-center gap-3 rounded-lg border border-red-200 bg-red-50 p-4">
      <div class="flex-shrink-0">
        <%= fa("passport", class: "fill-red-700", size: :lg) %>
      </div>

      <div class="text-sm text-red-900">
        <span class="font-semibold"><%= pluralize(unclaimed_check_ins_count, "passport") %></span> checked in at this
        event <%= (unclaimed_check_ins_count == 1) ? "hasn't" : "haven't" %> been claimed yet.
        <span class="text-red-700">Claim your Ruby Passport to appear in the list.</span>
      </div>
    </div>
  <% end %>

  <% if participants.any? %>
    <% if Current.user && participation.blank? %>
      <div class="mb-6 rounded-lg border-2 border-dashed border-purple-300 bg-purple-50 p-4">
        <div class="flex items-center gap-4">
          <div class="text-3xl">👋</div>

          <div class="flex-1">
            <h3 class="text-base font-semibold text-gray-900"><%= button_text %></h3>
            <p class="text-sm text-gray-600">Mark yourself as a participant!</p>
          </div>

          <div class="flex-shrink-0">
            <%= render partial: "events/participation_button", locals: {event: event, participation: participation} %>
          </div>
        </div>
      </div>
    <% end %>

    <% participants.each do |key, participants| %>
      <% unless participants.size.zero? %>
        <% show_unclaimed = key == "Known Participants" && unclaimed_check_ins_count > 0 %>
        <h2 class="mb-6">
          <%= key %> (<%= participants.size %>)
          <% if show_unclaimed %>
            <span class="text-base font-normal text-gray-400">+ <%= unclaimed_check_ins_count %> unclaimed</span>
          <% end %>
        </h2>

        <div
          id="<%= dom_id(event, key) %>"
          class="mb-12 grid h-full min-w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"
        >
          <% participants.each do |participant| %>
            <div class="transition-bg rounded-lg border bg-white duration-300 ease-in-out hover:bg-gray-200">
              <%= render partial: "users/card", locals: {user: participant, favorite_user: favorite_users[participant.id], checked_in: checked_in_participant_ids.include?(participant.id), stamp: event_stamp} %>
            </div>
          <% end %>

          <% if show_unclaimed %>
            <%= render "events/participants/unclaimed_card", count: unclaimed_check_ins_count %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if participants.empty? %>
    <div class="py-12 text-center">
      <div class="mx-auto max-w-md">
        <div class="mb-4 text-6xl">👥</div>

        <h2 class="mb-4 text-2xl font-bold text-gray-900">No Participants Yet</h2>

        <p class="mb-6 text-gray-600">
          Be the first to mark yourself as a participant of <%= event.name %>!
        </p>

        <%= render partial: "events/participation_button", locals: {event: event, participation: participation} %>

        <div class="mt-6 rounded-lg border border-purple-200 bg-purple-50 p-4 text-left">
          <h3 class="mb-2 font-semibold text-purple-800"><%= button_text %></h3>

          <p class="mb-3 text-sm text-purple-700">
            Help build the community memory by marking your participation at this event.
          </p>

          <ul class="space-y-1 text-sm text-purple-700">
            <li>• Connect with fellow participants</li>
            <li>• Share your experience with the community</li>
            <li>• Build your conference history</li>
          </ul>
        </div>
      </div>
    </div>
  <% end %>
</div>
