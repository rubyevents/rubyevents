<%# locals: (count:) %>

<div
  class="
    transition-bg h-full rounded-lg border border-dashed border-red-300 bg-red-50/40 duration-300 ease-in-out
    hover:bg-red-50
  "
>
  <div class="flex h-full items-center px-2">
    <div class="flex flex-1 items-center gap-4 p-2 px-4">
      <div class="flex size-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100">
        <%= fa("passport", class: "fill-orange-800", size: :lg) %>
      </div>

      <div class="min-w-0">
        <div class="line-clamp-1 text-base font-bold text-red-900">
          + <%= count %> unidentified <%= "Rubyist".pluralize(count) %>
        </div>

        <div class="line-clamp-2 text-xs text-red-700/70">Checked in but haven't claimed their Ruby Passport yet</div>
      </div>
    </div>
  </div>
</div>
