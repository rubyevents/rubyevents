<div class="mt-8 md:mt-12">
  <div class="mb-4 flex flex-col justify-between gap-1 md:mb-6 md:flex-row md:items-baseline md:gap-0">
    <h2 class="text-xl font-bold text-gray-900 md:text-2xl">Sometime in <%= year %></h2>
    <span class="text-xs text-gray-400 md:text-sm"><%= events.count %> events with unconfirmed dates</span>
  </div>

  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-3">
    <% events.each do |event| %>
      <%= link_to event_path(event), class: "group flex items-center gap-3 md:gap-4 p-3 md:p-4 bg-white rounded-xl border border-gray-100 hover:border-gray-300 hover:shadow-sm transition-all" do %>
        <div
          class="
            h-14 w-14 shrink-0 overflow-hidden rounded-lg shadow-sm ring-2 ring-gray-100 transition-all
            group-hover:ring-red-500 md:h-20 md:w-20 md:rounded-xl
          "
        >
          <%= image_tag event.avatar_image_path, alt: event.name, class: "w-full h-full object-cover", loading: "lazy" %>
        </div>

        <div class="min-w-0">
          <p class="truncate font-semibold text-gray-900 transition-colors group-hover:text-red-600">
            <%= event.name %>
          </p>

          <p class="truncate text-sm text-gray-500"><%= event.to_location.to_html(show_links: false) %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
