<%# locals: (day:, day_index:, tracks:, talks:, in_person_talk_ids:, online_talk_ids:, feedback_talk_ids:) %>

<% talk_count = 0 %>
<% date_string = Date.parse(day.dig("date")).strftime("%a %b %d") %>
<% day_string = day.dig("name") ? "#{day.dig("name")} - #{date_string}" : date_string %>

<div id="attendance-day-<%= day_index %>" class="mt-4">
  <h3 class="mb-2 text-center text-sm font-semibold text-gray-700"><%= day_string %></h3>

  <div class="divide-y overflow-hidden rounded border">
    <% day.dig("grid").each do |grid| %>
      <% start_time = grid["start_time"] %>
      <% end_time = grid["end_time"] %>
      <% slots = grid["slots"] %>
      <% items = grid.fetch("items", []) %>

      <div class="flex flex-col md:flex-row">
        <div
          class="
            flex w-full shrink-0 items-center justify-center border-b bg-gray-50 p-1 text-center text-xs
            text-gray-500 md:w-14 md:border-b-0 md:border-r md:p-1.5
          "
        >
          <span class="md:hidden"><%= start_time %><%= " - #{end_time}" if end_time %></span>
          <span class="hidden md:inline"><%= start_time %></span>
        </div>

        <div
          class="grid flex-1 grid-cols-1 md:grid-cols-[repeat(var(--slots),minmax(0,1fr))] md:divide-x"
          style="--slots: <%= slots %>"
        >
          <% slots.times do |i| %>
            <% talk = items.any? ? nil : talks[talk_count] %>

            <% if items.any? %>
              <% item = items[i] %>
              <div
                class="
                  flex items-center justify-center border-b bg-gray-50 p-1.5 text-xs text-gray-400 last:border-b-0
                  md:border-b-0
                "
              >
                <%= item.is_a?(String) ? item : item&.fetch("title", "-") %>
              </div>
            <% elsif talk %>
              <% talk_track = talk.static_metadata&.track %>
              <% track = talk_track && tracks.find { |t| t["name"] == talk_track } %>

              <div class="border-b last:border-b-0 md:border-b-0">
                <%= render "events/my_attendance_talk",
                      talk: talk,
                      track: track,
                      attended_in_person: in_person_talk_ids.include?(talk.id),
                      watched_online: online_talk_ids.include?(talk.id),
                      has_feedback: feedback_talk_ids.include?(talk.id) %>
              </div>

              <% talk_count += 1 %>
            <% else %>
              <div
                class="
                  flex items-center justify-center border-b bg-gray-50 p-1.5 text-xs text-gray-400 last:border-b-0
                  md:border-b-0
                "
              >
                -
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
