<% meetup = event.meetup? && event.start_date.present? %>
<% yaml_link = data_file_link_for(event, file: current_event_data_file) %>

<% if yaml_link && !meetup %>
  <div class="mb-2 flex justify-end"><%= yaml_link %></div>
<% end %>

<div id="event-tabs" class="<%= meetup ? "mb-6 flex flex-wrap items-center justify-between gap-2" : "mb-12" %>">
  <div role="tablist" class="tabs tabs-bordered">
    <%= active_link_to "Overview", event_path(event), class: "tab", active_class: "tab-active", role: "tab" %>

    <% if !(event.retreat? || event.meetup?) || event.talks.any? %>
      <%= active_link_to event_talks_path(event), class: class_names("tab", {"text-red-500" => !event.talks.any?}), active_class: "tab-active", role: "tab" do %>
        Talks
        <% unless event.talks.any? %>
          <%= fa("question-circle", size: :xs, class: "ml-1 fill-red-500") %>
        <% end %>
      <% end %>
    <% end %>

    <% if event.meetup_group? %>
      <%= active_link_to "Videos", event_videos_path(event), class: "tab", active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if event.speakers.any? %>
      <%= active_link_to "Speakers", event_speakers_path(event), class: "tab", active_class: "tab-active", role: "tab" %>
    <% end %>

    <%= active_link_to "Participants", event_participants_path(event), class: "tab", active_class: "tab-active", role: "tab" %>

    <% if event.event_involvements.any? %>
      <%= active_link_to "Involvements", event_involvements_path(event), class: "tab", active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if event.conference? || event.schedule.exist? %>
      <%= active_link_to event_schedules_path(event), class: class_names("tab", {"text-red-500" => !event.schedule.exist?}), active_class: "tab-active", role: "tab" do %>
        Schedule
        <% unless event.schedule.exist? %>
          <%= fa("question-circle", size: :xs, class: "ml-1 fill-red-500") %>
        <% end %>
      <% end %>
    <% end %>

    <% if event.conference? || event.venue.exist? %>
      <%= active_link_to event_venue_path(event), class: class_names("tab", {"text-red-500" => !event.venue.exist?}), active_class: "tab-active", role: "tab" do %>
        Venue
        <% unless event.venue.exist? %>
          <%= fa("question-circle", size: :xs, class: "ml-1 fill-red-500") %>
        <% end %>
      <% end %>
    <% end %>

    <% if event.conference? || event.sponsors.exists? %>
      <%= active_link_to event_sponsors_path(event), class: class_names("tab", {"text-red-500" => !event.sponsors.any?}), active_class: "tab-active", role: "tab" do %>
        Sponsors
        <% unless event.sponsors.any? %>
          <%= fa("question-circle", size: :xs, class: "ml-1 fill-red-500") %>
        <% end %>
      <% end %>
    <% end %>

    <% if event.conference? || event.cfps.any? %>
      <%= active_link_to event_cfp_index_path(event), class: class_names("tab", {"text-red-500" => event.cfps.none?}), active_class: "tab-active", role: "tab" do %>
        <% if event.cfps.open.any? %>
          CFP <span class="ml-1 text-green-600"> (open)</span>
        <% else %>
          CFP
        <% end %>

        <% if event.cfps.none? %>
          <%= fa("question-circle", size: :xs, class: "ml-1 fill-red-500") %>
        <% end %>
      <% end %>
    <% end %>

    <% if event.tickets.available? && !event.cancelled_or_inactive? %>
      <%= active_link_to "Tickets", event_tickets_path(event), class: "tab", active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if event.stickers.any? || Static::Stamp.for_event(event).any? %>
      <%= active_link_to "Collectibles", event_collectibles_path(event), class: "tab", active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if event.todos.any? %>
      <%= active_link_to "TODOs", event_todos_path(event), class: "tab", active_class: "tab-active", role: "tab" %>
    <% end %>
  </div>

  <% if yaml_link && meetup %>
    <div class="shrink-0"><%= yaml_link %></div>
  <% end %>
</div>
