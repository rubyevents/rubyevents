<%= render partial: "events/header", locals: {event: @event, participation: @participation} %>

<% if hotwire_native_app? && @event.live? %>
  <div
    class="container pt-4"
    data-controller="bridge--live-activity"
    data-bridge--live-activity-slug-value="<%= @event.slug %>"
    data-bridge--live-activity-name-value="<%= @event.name %>"
  >
    <button
      type="button"
      class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2 font-medium text-white transition-opacity"
      data-bridge--live-activity-target="button"
      data-action="click->bridge--live-activity#start"
    >
      <span data-bridge--live-activity-target="icon"><%= fa("circle-dot") %></span>
      <span data-bridge--live-activity-target="label">Follow live schedule</span>
    </button>
  </div>
<% end %>

<%= turbo_frame_tag dom_id(@event), data: {turbo_action: "advance", turbo_frame: "_top"} do %>
  <div class="container py-8">
    <%= render partial: "events/navigation", locals: {event: @event} %>
    <%= render Events::UpcomingEventBannerComponent.new(event: @event) %>

    <div class="mt-8 flex flex-col gap-12">
      <section class="rounded-lg border bg-white p-6 shadow-sm">
        <div class="grid items-center gap-6 <%= (!event_cancelled?(@event) && @event.start_date.present? && @event.start_date > Date.today && @event.date_precision == "day" || (@event.today? && !@event.meetup? && !event_cancelled?(@event))) ? "grid-cols-2 sm:grid-cols-4" : "grid-cols-3" %>">
          <div class="text-center">
            <% if @event.retreat? %>
              <% duration = (@event.end_date - @event.start_date).to_i %>

              <div class="mb-1 text-3xl font-bold text-primary"><%= duration %></div>
              <div class="text-sm font-medium text-gray-600"><%= "Day".pluralize(duration) %></div>
            <% else %>
              <div class="mb-1 text-3xl font-bold text-primary"><%= @event.talks.count %></div>
              <div class="text-sm font-medium text-gray-600">Talks</div>
            <% end %>
          </div>

          <div class="text-center">
            <% if @event.retreat? %>
              <div class="mb-1 text-3xl font-bold text-primary"><%= @event.participants.count %></div>
              <div class="text-sm font-medium text-gray-600">Known Participants</div>
            <% else %>
              <div class="mb-1 text-3xl font-bold text-primary"><%= @event.speakers.count %></div>
              <div class="text-sm font-medium text-gray-600">Speakers</div>
            <% end %>
          </div>

          <div class="text-center">
            <% if @event.meetup? %>
              <div class="mb-1 text-3xl font-bold text-primary"><%= @event.talks.where(meta_talk: true).count %></div>
              <div class="text-sm font-medium text-gray-600">Events</div>
            <% else %>
              <div class="mb-1 text-3xl font-bold text-primary"><%= @event.sponsors.count %></div>
              <div class="text-sm font-medium text-gray-600">Sponsors</div>
            <% end %>
          </div>

          <% if !event_cancelled?(@event) && @event.start_date.present? && @event.start_date > Date.today && @event.date_precision == "day" %>
            <% days_until = (@event.start_date - Date.today).to_i %>
            <div class="text-center">
              <div class="mb-2 flex justify-center gap-1">
                <% days_str = days_until.to_s.rjust(2, "0") %>

                <% days_str.chars.each do |digit| %>
                  <div class="font-mono relative flex h-12 w-8 items-center justify-center rounded bg-gray-900">
                    <div class="absolute inset-0 overflow-hidden rounded-t" style="clip-path: inset(0 0 50% 0);">
                      <div class="flex h-full items-center justify-center text-xl font-bold text-white">
                        <%= digit %>
                      </div>
                    </div>

                    <div class="absolute inset-0 overflow-hidden rounded-b" style="clip-path: inset(50% 0 0 0);">
                      <div class="flex h-full items-center justify-center text-xl font-bold text-white">
                        <%= digit %>
                      </div>
                    </div>

                    <div class="absolute inset-x-0 top-1/2 z-10 h-px -translate-y-px transform bg-black shadow-sm"></div>
                  </div>
                <% end %>
              </div>

              <div class="text-sm font-medium text-gray-600">Days Until</div>
            </div>
          <% elsif !event_cancelled?(@event) && @event.today? && !@event.meetup? %>
            <div class="text-center">
              <div class="mb-1 animate-pulse text-2xl font-bold text-green-600">
                LIVE
              </div>

              <div class="text-sm font-medium text-gray-600">Happening Now</div>
            </div>
          <% end %>
        </div>
      </section>

      <% if @event.meetup? && (@upcoming_meetup_events&.any? || @recent_meetup_events&.any?) %>
        <% if @upcoming_meetup_events&.any? %>
          <section class="flex w-full flex-col gap-4">
            <div class="flex w-full items-center justify-between">
              <h2 class="shrink-0 text-primary">Upcoming Events</h2>
              <%= link_to "see all events", event_events_path(@event), class: "link text-right w-full" %>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              <% @upcoming_meetup_events.each do |meta_talk| %>
                <%= render "shared/meta_talk_card", meta_talk: meta_talk, compact_speakers: true, hide_date_sidebar: true %>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if @recent_meetup_events&.any? %>
          <section class="flex w-full flex-col gap-4">
            <div class="flex w-full items-center justify-between">
              <h2 class="shrink-0 text-primary">Recent Events</h2>
              <%= link_to "see all events", event_events_path(@event), class: "link text-right w-full" %>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              <% @recent_meetup_events.each do |meta_talk| %>
                <%= render "shared/meta_talk_card", meta_talk: meta_talk, compact_speakers: true, hide_date_sidebar: true %>
              <% end %>
            </div>
          </section>
        <% end %>
      <% elsif @keynotes&.any? %>
        <section class="flex w-full flex-col gap-4">
          <div class="flex w-full items-center justify-between">
            <h2 class="shrink-0 text-primary">Keynotes</h2>
            <%= link_to "see all talks", event_talks_path(@event), class: "link text-right w-full" %>
          </div>

          <div class="grid min-w-full grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <%= render partial: "talks/card",
                  collection: @keynotes,
                  as: :talk,
                  locals: {
                    favoritable: true,
                    user_favorite_talks_ids: @user_favorite_talks_ids,
                    user_watched_talks: user_watched_talks,
                    back_to: event_path(@event),
                    back_to_title: @event.name
                  } %>
          </div>
        </section>
      <% end %>

      <% if @recent_talks.any? %>
        <section class="flex w-full flex-col gap-4">
          <div class="flex w-full items-center justify-between">
            <h2 class="shrink-0 text-primary">Talks</h2>
            <%= link_to "see all talks", event_talks_path(@event), class: "link text-right w-full" %>
          </div>

          <div class="grid min-w-full grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            <%= render partial: "talks/card",
                  collection: @recent_talks,
                  as: :talk,
                  locals: {
                    favoritable: true,
                    user_favorite_talks_ids: @user_favorite_talks_ids,
                    user_watched_talks: user_watched_talks,
                    back_to: event_path(@event),
                    back_to_title: @event.name
                  } %>
          </div>
        </section>
      <% end %>

      <% if @featured_speakers.any? %>
        <section class="flex w-full flex-col gap-4">
          <div class="flex w-full items-center justify-between">
            <h2 class="shrink-0 text-primary">Speakers</h2>
            <%= link_to "see all speakers", event_speakers_path(@event), class: "link text-right w-full" %>
          </div>

          <div class="relative" data-controller="scroll">
            <div
              class="snap-x snap-mandatory overflow-x-auto scroll-smooth"
              data-scroll-target="container"
              data-action="scroll->scroll#checkScroll"
            >
              <div class="flex gap-4 pb-4">
                <% @featured_speakers.each do |speaker| %>
                  <div class="snap-start" data-scroll-target="card">
                    <%= render partial: "speakers/card", locals: {speaker: speaker} %>
                  </div>
                <% end %>
              </div>
            </div>

            <div
              class="pointer-events-none absolute right-0 top-0 h-full w-24 bg-gradient-to-l from-white to-transparent"
              data-scroll-target="gradient"
            ></div>
          </div>
        </section>
      <% end %>

      <% if @sponsors.any? %>
        <section class="flex w-full flex-col gap-4">
          <div class="flex w-full items-center justify-between">
            <h2 class="shrink-0 text-primary">Sponsors</h2>
            <%= link_to "see all sponsors", event_sponsors_path(@event), class: "link text-right w-full" %>
          </div>

          <div class="relative" data-controller="scroll">
            <div
              class="snap-x snap-mandatory overflow-x-auto scroll-smooth"
              data-scroll-target="container"
              data-action="scroll->scroll#checkScroll"
            >
              <div class="flex gap-4 pb-4">
                <% @sponsors.each do |sponsor| %>
                  <div class="snap-start" data-scroll-target="card">
                    <%= render partial: "organizations/card", locals: {
                          organization: sponsor.organization,
                          sponsor: sponsor,
                          turbo_frame: true,
                          hide_event_count: true
                        } %>
                  </div>
                <% end %>
              </div>
            </div>

            <div
              class="pointer-events-none absolute right-0 top-0 h-full w-24 bg-gradient-to-l from-white to-transparent"
              data-scroll-target="gradient"
            ></div>
          </div>
        </section>
      <% end %>

      <% if @event.talks.empty? && @event.speakers.empty? && @sponsors.empty? && !@event.static_metadata.cancelled? %>
        <div class="py-12 text-center">
          <div class="mx-auto max-w-md">
            <div class="mb-4 text-6xl">🎤</div>
            <h2 class="mb-4 text-2xl font-bold text-gray-900">Coming Soon</h2>

            <p class="mb-6 text-gray-600">
              Help us make this event complete! Do you have recordings, speaker info, or sponsor details for
              <%= @event.name %>?
            </p>

            <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-left">
              <h3 class="mb-2 font-semibold text-amber-800">How to contribute:</h3>

              <ul class="space-y-1 text-sm text-amber-700">
                <li>• Check the event website or program</li>
                <li>• Look for recordings or speaker information</li>

                <li>
                  •
                  <a href="https://github.com/rubyevents/rubyevents/issues/new?title=<%= CGI.escape("#{@event.name} Content") %>&body=<%= CGI.escape("<!-- Your Content Here -->\n\nIssue opened from event page: #{event_url(@event)}") %>" class="underline hover:text-amber-900" target="_blank">Open an issue on GitHub</a>
                </li>

                <li>
                  •
                  <a href="https://github.com/rubyevents/rubyevents/blob/main/CONTRIBUTING.md" class="underline hover:text-amber-900" target="_blank">Submit data via GitHub</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
