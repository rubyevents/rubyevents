<div
  data-event-list-target="poster"
  data-event-id="<%= event.slug %>"
  class="
    lg:h-92 relative hidden w-full overflow-hidden rounded-[25px] border p-4 text-center lg:rounded-[50px] lg:p-16
    lg:text-left
  "
  style="
    color: <%= event.static_metadata.featured_color %>;
    <% if event.static_metadata.featured_background.start_with?("data:") %>
      background: url('<%= event.static_metadata.featured_background %>');
      background-repeat: no-repeat;
      background-size: cover;
    <% else %>
      background: <%= event.static_metadata.featured_background %>;
    <% end %>
  "
>
  <a href="<%= event_path(event) %>">
    <div class="grid-cols-[1fr_2fr] <% if event.static_metadata.cancelled? %> opacity-50 grayscale <% end %>">
      <div>
        <div class="mb-9 flex justify-center">
          <%= image_tag event.featured_image_path, class: "w-[200px] max-h-none lg:w-full", loading: "lazy", width: 615, height: 350, alt: event.name %>
        </div>

        <div class="flex flex-col items-center gap-3 overflow-hidden lg:h-48 lg:max-h-48 lg:items-start">
          <h1 class="line-clamp-1 text-xl font-bold text-inherit lg:line-clamp-2"><%= event.name %></h1>

          <h2 class="line-clamp-1 text-sm text-inherit opacity-60">
            <%= event.to_location.to_html(show_links: false) %> • <%= event.formatted_dates %>
          </h2>

          <h2 class="line-clamp-3 hidden text-sm font-medium text-inherit lg:block">
            <%= event.description %>
            <%= home_updated_text(event) %>
          </h2>
        </div>
      </div>
    </div>
  </a>

  <% if event.static_metadata.cancelled? %>
    <div class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center">
      <span
        class="
          -rotate-12 bg-red-600 px-16 py-3 text-2xl font-bold uppercase tracking-widest text-white shadow-lg
          lg:text-4xl
        "
      >
        Cancelled
      </span>
    </div>
  <% end %>
</div>
