<div id="involvements_list">
  <% if involvements_by_role.any? %>
    <% involvements_by_role.each do |role, involvements| %>
      <div class="mb-12">
        <h2 class="mb-6"><%= role.pluralize(involvements.count) %></h2>

        <div class="grid h-full min-w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <% involvements.each do |involvement| %>
            <% if involvement.involvementable_type == "User" %>
              <div class="transition-bg rounded-lg border bg-white duration-300 ease-in-out hover:bg-gray-200">
                <%= render partial: "users/card", locals: {user: involvement.involvementable} %>
              </div>
            <% elsif involvement.involvementable_type == "Organization" %>
              <div class="transition-bg rounded-lg border bg-white duration-300 ease-in-out hover:bg-gray-200">
                <%= render partial: "organizations/compact_card", locals: {organization: involvement.involvementable, hide_event_count: true, turbo_frame: true} %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="py-12 text-center">
      <div class="mx-auto max-w-md">
        <div class="mb-4 text-6xl">🤝</div>
        <h2 class="mb-4 text-2xl font-bold text-gray-900">No Involvements Yet</h2>

        <p class="text-gray-600">
          Event involvements information is not available for <%= event.name %> yet.
        </p>
      </div>
    </div>
  <% end %>
</div>
