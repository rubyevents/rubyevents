<%# locals: (talks:, active_talk:, user_watched_talks:) %>

<div class="group relative rounded-xl border border-transparent hover:border-gray-200">
  <div
    class="flex flex-col gap-2 overflow-y-scroll lg:max-h-[390px] xl:max-h-[480px] 2xl:max-h-[625px]"
    data-controller="scroll-into-view talks-navigation"
  >
    <%= render partial: "talks/card_horizontal",
          collection: talks,
          as: :talk,
          locals: {compact: true,
                   current_talk: active_talk,
                   turbo_frame: "talk",
                   user_watched_talks: user_watched_talks} %>
  </div>

  <div
    class="
      pointer-events-none absolute bottom-0 left-0 h-36 w-full bg-gradient-to-t from-base-100 to-transparent
      group-hover:hidden
    "
  ></div>
</div>
