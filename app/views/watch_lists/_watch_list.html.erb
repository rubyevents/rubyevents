<div class="flex flex-col gap-4">
  <% if watch_list.talks.present? %>
    <div id="talks" class="gallery grid min-w-full grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <%= render partial: "talks/card",
            collection: watch_list.talks,
            as: :talk,
            locals: {
              favoritable: true,
              user_favorite_talks_ids: watch_list.talks.ids,
              user_watched_talks: user_watched_talks,
              back_to: watch_lists_path,
              back_to_title: watch_list.name
            } %>
    </div>
  <% else %>
    <div class="py-12 text-center">
      <div class="mx-auto max-w-md">
        <div class="mb-4 text-6xl">🔖</div>

        <h2 class="mb-4 text-2xl font-bold text-gray-900">No bookmarks yet</h2>

        <p class="mb-6 text-gray-600">
          Start bookmarking talks and easily find them later.
        </p>

        <div class="rounded-lg border border-purple-200 bg-purple-50 p-4 text-left">
          <h3 class="mb-2 font-semibold text-purple-800">How to bookmark talks:</h3>

          <ul class="space-y-1 text-sm text-purple-700">
            <li>• Browse talks and click the bookmark icon</li>
            <li>• Access your bookmarks anytime</li>
          </ul>
        </div>

        <div class="mt-6">
          <%= link_to talks_path, class: "btn btn-primary" do %>
            <%= fa "video", variant: :solid, class: "w-5 h-5 mr-2" %> Browse Talks
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
