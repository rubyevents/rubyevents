<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="container py-8">
  <div class="align-center block justify-between gap-8 lg:flex">
    <div class="lg:justify-right mb-6 flex flex-col items-center gap-8 text-center lg:mb-0 lg:flex-row lg:text-left">
      <span class="fi w-36 rounded border text-[80pt] fi-<%= @country.alpha2.downcase %>"></span>

      <div class="flex flex-col justify-center">
        <h1 class="mb-2 font-bold text-black">
          <%= title "Ruby Community in #{@state.name}" %>
        </h1>

        <h3 class="hidden text-[#636B74] md:block">
          <%= link_to @country.name, country_path(@country), class: "hover:underline" %>
        </h3>
      </div>
    </div>

    <div class="flex flex-col place-items-center gap-3">
      <%= ui_button "View all events in #{@country.name}", url: country_path(@country), kind: :secondary, size: :sm, class: "w-full" %>
    </div>
  </div>

  <p class="mb-6 mt-3 max-w-[700px] text-[#636B74] md:mt-9">
    We have indexed <%= pluralize(@users.count, "Rubyist") %> and <%= pluralize(@events.count, "event") %> in
    <%= @state.name %>.
  </p>

  <% if @users.any? %>
    <div id="rubyists" class="mt-12">
      <section class="flex w-full flex-col gap-4">
        <div class="flex w-full items-center justify-between">
          <h2 class="shrink-0 text-primary">Rubyists in <%= @state.name %></h2>
        </div>

        <div class="grid min-w-full grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          <% @users.each do |user| %>
            <%= render partial: "users/card", locals: {user: user, content: user.to_location.to_text} %>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>

  <% if (groups = @events.group_by(&:kind)).any? %>
    <% groups.each do |kind, events| %>
      <div id="events" class="mt-12">
        <section class="flex w-full flex-col gap-4">
          <div class="flex w-full items-center justify-between">
            <h2 class="shrink-0 text-primary"><%= kind.humanize.pluralize %></h2>
          </div>

          <div class="grid min-w-full grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            <%= cache events do %>
              <%= render partial: "events/card", collection: events, as: :event, cached: true %>
            <% end %>
          </div>
        </section>
      </div>
    <% end %>
  <% end %>

  <% if @cities.any? %>
    <div id="cities" class="mt-12">
      <section class="flex w-full flex-col gap-4">
        <div class="flex w-full items-center justify-between">
          <h2 class="shrink-0 text-primary">Cities</h2>
        </div>

        <div class="grid min-w-full gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-12 xl:grid-cols-4">
          <% @cities.each do |city| %>
            <%= link_to city.path, id: "city-#{city.slug}", class: "event flex justify-between items-center" do %>
              <div class="flex items-center gap-2">
                <span class="event-name"><%= city.name %></span>
              </div>

              <%= ui_badge(city.events_count, kind: :secondary, outline: true, size: :lg, class: "min-w-10") %>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>
</div>
