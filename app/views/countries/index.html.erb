<div class="container py-8">
  <div class="flex w-full items-center justify-between hotwire-native:hidden">
    <h1 class="title">
      <%= title "Countries" %>
    </h1>
  </div>

  <p class="mb-6 mt-3 max-w-[700px] text-[#636B74] md:mt-6">
    Explore Ruby events and Rubyists from around the world by country.
  </p>

  <div
    id="map"
    class="mt-6 h-96 w-full rounded-lg"
    data-controller="map"
    data-map-markers-value="<%= @event_map_markers.to_json %>"
  ></div>

  <div class="mt-6">
    <% @countries_by_continent.each do |continent, countries| %>
      <% if countries.any? %>
        <h2 class="mt-3"><%= link_to continent.name, continent_path(continent), class: "hover:underline" %></h2>

        <div
          id="events-<%= continent.name %>"
          class="grid min-w-full gap-x-8 gap-y-2 pb-8 pt-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-12 2xl:grid-cols-4"
        >
          <% countries.sort_by(&:iso_short_name).each do |country| %>
            <% events = @events_by_country[country] %>
            <% users_count = @users_by_country[country] || 0 %>
            <% next if events.nil? %>

            <%= link_to country_path(country.slug), id: "country-#{country.alpha2}", class: "event flex justify-between items-center" do %>
              <div class="flex items-center gap-2">
                <span class="event-name"><%= country.emoji_flag %> <%= country.name %></span>
              </div>

              <div class="flex items-center gap-2">
                <% if users_count > 0 %>
                  <%= ui_badge(
                        "#{users_count} #{"Rubyist".pluralize(users_count)}",
                        kind: :primary,
                        outline: true,
                        size: :md,
                        class: "whitespace-nowrap"
                      ) %>
                <% end %>

                <%= ui_badge(
                      events.count,
                      kind: :secondary,
                      outline: true,
                      size: :lg,
                      class: "min-w-10"
                    ) %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
