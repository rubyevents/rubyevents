<div id="event-list" class="group relative flex flex-col gap-2 rounded-xl">
  <% events.each do |event| %>
    <%= link_to event_cfp_index_path(event), class: "call-for-papers-item flex gap-4 group p-2 hover:bg-gray-200 rounded-md" do %>
      <div class="lg:justify-right flex flex-shrink-0 flex-col items-center gap-8 text-center lg:flex-row lg:text-left">
        <%= image_tag image_path(event.avatar_image_path),
              class: "rounded-xl border border-[#D9DFE3] size-16",
              alt: event.name.to_s,
              loading: :lazy %>
      </div>

      <div class="relative flex flex-col justify-center overflow-hidden">
        <div class="text-xl font-bold text-black group-hover:text-inherit">
          <%= event.name %>
        </div>

        <div class="text-[#636B74] group-hover:text-inherit">
          <% if event.formatted_dates != "unknown" %>
            <%= event.formatted_dates %> •
          <% end %>

          <%= event.to_location.to_html(show_links: false) %>
        </div>

        <% event.cfps.open.each do |cfp| %>
          <div class="font-bold text-[#636B74] group-hover:text-inherit">
            <%= cfp.name.presence || "Call for Proposals" %>

            <% if cfp.close_date.present? && (cfp.open_date.blank? || cfp.open_date.past?) %>
              - closes on <%= cfp.formatted_close_date %>
            <% elsif cfp.open_date.present? && cfp.open_date.future? %>
              - opens on <%= cfp.formatted_open_date %>
            <% elsif cfp.open_ended? %>
              - always open
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="absolute right-2 hidden gap-2 sm:flex">
        <%= render "shared/cfp_countdown_badge", event: event %>
        <%= render "shared/event_countdown_badge", event: event %>
      </div>
    <% end %>
  <% end %>
</div>
