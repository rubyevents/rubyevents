<% return if event.static_metadata.cancelled? %>

<% event.cfps.each do |cfp| %>
  <% if cfp.future? %>
    <% cfp_open_days = cfp.days_until_open %>

    <div class="flex flex-col justify-center">
      <div
        class="
          flex h-16 w-16 flex-col items-center justify-center self-end rounded-xl bg-blue-500 text-xs leading-none
          text-white
        "
      >
        <div class="text-[10px]">CFP in</div>
        <div class="text-lg font-bold"><%= cfp_open_days %></div>
        <div class="text-[10px]"><%= "day".pluralize(cfp_open_days) %></div>
      </div>
    </div>
  <% elsif cfp.open? %>
    <% if cfp.open_ended? %>
      <div class="flex flex-col justify-center">
        <div
          class="
            flex h-16 w-16 flex-col items-center justify-center self-end rounded-xl bg-green-500 text-xs
            leading-none text-white
          "
        >
          <div class="text-lg font-bold">CFP</div>
          <div class="text-[10px]">Always</div>
          <div class="text-[10px]">Open</div>
        </div>
      </div>
    <% else %>
      <% cfp_days = cfp.days_remaining %>

      <% if cfp_days %>
        <div class="flex flex-col justify-center">
          <div
            class="
              flex h-16 w-16 flex-col items-center justify-center self-end rounded-xl bg-green-500 text-xs
              leading-none text-white
            "
          >
            <% if cfp_days == 0 %>
              <div class="text-lg font-bold">CFP</div>
              <div class="text-[10px]">Last day!</div>
            <% elsif cfp_days == 1 %>
              <div class="text-lg font-bold">CFP</div>
              <div class="text-[10px]">Tomorrow</div>
            <% else %>
              <div class="text-[10px]">CFP</div>
              <div class="text-lg font-bold"><%= cfp_days %></div>
              <div class="text-[10px]"><%= "day".pluralize(cfp_days) %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
