<% if event.static_metadata.cancelled? %>
  <div class="flex flex-col justify-center">
    <div
      class="
        flex h-16 w-16 flex-col items-center justify-center self-end rounded-xl bg-red-600 text-xs leading-none
        text-white
      "
    >
      <div class="text-[11px] font-bold">Cancelled</div>
    </div>
  </div>
<% elsif event.start_date && event.date_precision == "day" %>
  <% days = (event.start_date - Date.current).to_i %>
  <% today = (event.start_date..event.end_date).include?(Date.current) %>

  <% if days == 0 || today %>
    <div class="flex flex-col justify-center">
      <div
        class="
          flex h-16 w-16 flex-col items-center justify-center self-end rounded-xl bg-[#636B74] text-xs leading-none
          text-white
        "
      >
        <div class="text-[12px]">Today</div>
      </div>
    </div>
  <% elsif days == 1 %>
    <div class="flex flex-col justify-center">
      <div
        class="
          flex h-16 w-16 flex-col items-center justify-center self-end rounded-xl bg-[#636B74] text-xs leading-none
          text-white
        "
      >
        <div class="text-[12px]">Tomorrow</div>
      </div>
    </div>
  <% elsif days >= 0 %>
    <div class="flex flex-col justify-center">
      <div
        class="
          flex h-16 w-16 flex-col items-center justify-center self-end rounded-xl bg-[#636B74] text-xs leading-none
          text-white
        "
      >
        <div class="text-lg font-bold"><%= days %></div>
        <div class="mt-1 text-[13px]"><%= "day".pluralize(days) %></div>
      </div>
    </div>
  <% end %>
<% end %>
