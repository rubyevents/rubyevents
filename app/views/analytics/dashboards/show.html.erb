<% content_for :head do %>
  <%= vite_javascript_tag "chartkick" %>
<% end %>

<div class="container my-8 flex w-full flex-col gap-4">
  <h1 class="mb-8 text-center">Open analytics</h1>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
    <%= turbo_frame_tag "daily_visits", src: daily_visits_analytics_dashboards_path, lazy: true do %>
      <h2 class="mb-4 text-center">Daily visits</h2>
      <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
    <% end %>

    <%= turbo_frame_tag "daily_page_views", src: daily_page_views_analytics_dashboards_path, lazy: true do %>
      <h2 class="mb-4 text-center">Daily page views</h2>
      <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
    <% end %>

    <%= turbo_frame_tag "monthly_visits", src: monthly_visits_analytics_dashboards_path, lazy: true do %>
      <h2 class="mb-4 text-center">Monthly visits</h2>
      <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
    <% end %>

    <%= turbo_frame_tag "monthly_page_views", src: monthly_page_views_analytics_dashboards_path, lazy: true do %>
      <h2 class="mb-4 text-center">Monthly page views</h2>
      <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
    <% end %>

    <%# TODO convert those metrics to Rollup to re enable them %>
    <% if Current.user&.admin? && false %>
      <%= turbo_frame_tag "top_referrers", src: top_referrers_analytics_dashboards_path, lazy: true do %>
        <h2 class="mb-4 text-center">Top referrers</h2>
        <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
      <% end %>
      <%= turbo_frame_tag "top_landing_pages", src: top_landing_pages_analytics_dashboards_path, lazy: true do %>
        <h2 class="mb-4 text-center">Top landing pages</h2>
        <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
      <% end %>
      <%= turbo_frame_tag "top_searches", src: top_searches_analytics_dashboards_path, lazy: true do %>
        <h2 class="mb-4 text-center">Top searches</h2>
        <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
      <% end %>
    <% end %>

    <%= turbo_frame_tag "yearly_talks", src: yearly_talks_analytics_dashboards_path, lazy: true do %>
      <h2 class="mb-4 text-center">Yearly talks</h2>
      <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
    <% end %>

    <%= turbo_frame_tag "yearly_conferences", src: yearly_conferences_analytics_dashboards_path, lazy: true do %>
      <h2 class="mb-4 text-center">Yearly Conferencess</h2>
      <div class="h-[300px] animate-pulse rounded-lg bg-gray-300"></div>
    <% end %>
  </div>
</div>
