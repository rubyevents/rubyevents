<div class="py-12 text-center">
  <div class="mx-auto max-w-md">
    <div class="mb-4 text-6xl">👥</div>
    <h2 class="mb-4 text-2xl font-bold text-gray-900">No Favorite Rubyists Yet</h2>

    <p class="mb-6 text-gray-600">
      Below a list of speakers recommended for you.
    </p>
  </div>
</div>

<div id="favorite_users" class="mt-2 grid min-w-full gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% recommendations.each do |favorite_user| %>
    <div id="<%= dom_id favorite_user %>">
      <div
        class="
          transition-bg flex items-center justify-between rounded-lg border bg-white duration-300 ease-in-out
          hover:bg-gray-200
        "
      >
        <%= render partial: "users/card", locals: {user: favorite_user.favorite_user, favorite_user: favorite_user} %>
      </div>
    </div>
  <% end %>
</div>
