<% count = User::DuplicateDetector.all_duplicate_ids.count %>

<div class="flex h-full flex-col justify-between p-6">
  <div class="text-center">
    <div class="text-4xl font-bold <%= (count > 0) ? "text-yellow-600" : "text-green-600" %>">
      <%= count %>
    </div>

    <div class="mt-1 text-sm text-gray-500">users with potential duplicates</div>
  </div>

  <div class="mt-4 text-center">
    <%= link_to "View Details →",
          avo_dashboards.dashboard_path(:duplicates),
          class: "text-sm text-blue-600 hover:text-blue-800 hover:underline font-medium",
          data: {turbo_frame: "_top"} %>
  </div>
</div>
