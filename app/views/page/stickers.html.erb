<div class="bg-black">
  <div class="container">
    <%= render partial: "shared/stickers_display", locals: {stickers: @stickers} %>

    <div class="pb-12">
      <h2 class="mb-8 text-center text-3xl font-bold text-white">Available Stickers</h2>

      <div class="space-y-8">
        <% @events.group_by(&:series).sort_by { |org, _| org.name }.each do |series, series_events| %>
          <div class="rounded-lg bg-gray-900 p-6">
            <h3 class="mb-4 text-xl font-semibold text-white"><%= series.name %></h3>

            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
              <% series_events.sort_by { |e| e.date || Date.new(1900, 1, 1) }.reverse.each do |event| %>
                <% event.stickers.each do |sticker| %>
                  <%= link_to event, class: "group relative bg-gray-800 rounded-lg p-4 hover:bg-gray-700 transition-colors" do %>
                    <div class="mb-2 flex aspect-square items-center justify-center">
                      <%= image_tag sticker.asset_path, alt: sticker.name, class: "max-w-full max-h-full object-contain group-hover:scale-110 transition-transform" %>
                    </div>

                    <p class="truncate text-center text-xs text-gray-300"><%= event.name %></p>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
