<h2 id="button" class="group mb-4 text-2xl font-bold">
  <a href="#button" class="mr-1 text-gray-400 no-underline opacity-0 group-hover:opacity-100" aria-label="Link to Button">#</a>
  Button
</h2>

<div class="flex w-full gap-16">
  <div class="mb-8 flex flex-wrap items-center justify-start gap-4">
    <% [:primary, :secondary, :neutral, :rounded, :ghost, :link].each do |kind| %>
      <%= ui_button kind.to_s.capitalize, kind: kind %>
    <% end %>
  </div>

  <div class="flex justify-center">
    <div class="flex w-36 flex-col gap-4">
      <p>Example</p>
      <%= ui_button "Preview", kind: :neutral %>
      <%= ui_button "Edit", kind: :secondary %>
      <%= ui_button "Save", kind: :primary %>
      <%= ui_button "Cancel", kind: :ghost %>
    </div>
  </div>
</div>

<p>small versions</p>

<div class="mb-8 mt-4 flex flex-wrap items-center justify-start gap-4">
  <% [:primary, :secondary, :neutral, :rounded, :ghost, :link].each do |kind| %>
    <%= ui_button kind.to_s.capitalize, kind: kind, size: :sm %>
  <% end %>
</div>

<p>Pill buttons for toolbars</p>

<div class="mb-8 mt-4 flex flex-wrap items-center justify-start gap-4">
  <%= ui_button kind: :pill do %>
    <%= fa("pencil", size: :sm) %>
    <span>Edit</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <%= fa("share-nodes", size: :sm) %>
    <span>Share</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <%= fa("trash-can", size: :sm) %>
    <span>Delete</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <%= fa("link", size: :sm) %>
    <span>Link</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <%= fa("bookmark", style: :regular, size: :sm) %>
    <span>Bookmark</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <%= fa("bookmark", style: :solid, class: "text-primary", size: :sm) %>
    <span>Bookmark</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <%= fa("circle", size: :sm, style: :regular) %>
    <span class="text-nowrap">Watched</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <%= fa("circle-check", size: :sm, style: :solid, class: "fill-green-700") %>
    <span class="text-nowrap">Watched</span>
  <% end %>
</div>

<p>Pill buttons for filters</p>

<div class="mb-8 mt-4 flex flex-wrap items-center justify-start gap-4">
  <%= ui_button kind: :pill, class: "active" do %>
    <span>Portuguese (5)</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <span>English (10)</span>
  <% end %>

  <%= ui_button kind: :pill do %>
    <span>French (2)</span>
  <% end %>
</div>
