<h2 id="avatar" class="group mb-4 text-2xl font-bold">
  <a href="#avatar" class="mr-1 text-gray-400 no-underline opacity-0 group-hover:opacity-100" aria-label="Link to Avatar">#</a>
  Avatar
</h2>

<% avatarable = User.speakers.first %>

<div class="flex w-full gap-16">
  <div class="mb-8 flex flex-wrap items-center justify-start gap-4">
    <% [:primary, :neutral].each do |kind| %>
      <div class="text-center">
        <%= ui_avatar avatarable, kind: kind %><br>
        <%= kind %>
      </div>
    <% end %>
  </div>
</div>

<p>Sizes</p>

<div class="mb-8 mt-4 flex flex-wrap items-center justify-start gap-4">
  <% [:sm, :md, :lg].each do |size| %>
    <div class="text-center">
      <%= ui_avatar avatarable, size: size %><br>
      <%= size %>
    </div>
  <% end %>
</div>

<p>Outline</p>

<div class="mb-8 mt-4 flex w-80 flex-wrap items-center justify-start gap-4 bg-gray-500 p-2">
  <% [true, false].each do |value| %>
    <div class="text-center text-white">
      <%= ui_avatar avatarable, outline: value %><br>
      <%= value.to_s %>
    </div>
  <% end %>
</div>

<p>Custom size class</p>

<div class="mb-8 mt-4 flex flex-wrap items-center justify-start gap-4">
  <% ["w-10", "w-20"].each do |size_class| %>
    <div class="text-center">
      <%= ui_avatar avatarable, size_class: size_class %><br>
      <%= size_class %>
    </div>
  <% end %>
</div>
