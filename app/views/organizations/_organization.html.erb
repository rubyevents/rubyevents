<%= link_to organization_path(organization), id: dom_id(organization), class: "flex justify-between" do %>
  <div class="flex items-center gap-2">
    <%= render "organizations/avatar", organization: organization %>

    <span class="line-clamp-1"><%= organization.name %></span>
  </div>

  <%= ui_badge(organization.event_involvements.size + organization.events.size, kind: :secondary, outline: true, size: :lg, class: "min-w-10") %>
<% end %>
