<% grid_layout = defined?(grid_layout) && grid_layout %>
<% width_class = grid_layout ? "w-full" : "w-48 sm:w-64" %>

<%= link_to organization_path(organization), class: "#{width_class} flex relative bg-white rounded-xl border h-full hover:shadow-lg hover:border-gray-300 transition-all duration-200 transform hover:-translate-y-1", data: {turbo_frame: ((defined?(turbo_frame) && turbo_frame) ? "_top" : nil)} do %>
  <div class="card card-compact w-full pt-6">
    <figure class="flex justify-center px-4">
      <% image_size_class = grid_layout ? "w-24 h-24 sm:w-32 sm:h-32" : "w-32 h-32 sm:w-40 sm:h-40" %>

      <% if organization.has_logo_image? %>
        <div class="rounded-lg border border-gray-200 p-2 <%= organization.logo_background_class %>">
          <%= image_tag(
                organization.logo_image_path,
                alt: "#{organization.name} logo",
                class: "#{image_size_class} object-contain",
                loading: "lazy",
                onerror: "this.style.display='none'; this.nextElementSibling.style.display='flex';"
              ) %>

          <div class="items-center justify-center <%= image_size_class %>" style="display: none;">
            <span class="line-clamp-3 text-center text-lg font-semibold text-gray-700"><%= organization.name %></span>
          </div>
        </div>
      <% else %>
        <div class="flex items-center justify-center <%= image_size_class %>">
          <span class="line-clamp-3 text-center text-lg font-semibold text-gray-700"><%= organization.name %></span>
        </div>
      <% end %>
    </figure>

    <div class="card-body items-center justify-center px-0 pt-4 text-center <%= "pb-6" if defined?(hide_event_count) && hide_event_count %>">
      <h3 class="line-clamp-1 font-semibold text-slate-700 <%= grid_layout ? "text-sm sm:text-base" : "text-xl" %>">
        <%= organization.name %>
      </h3>

      <% if defined?(sponsor) && sponsor&.badge.present? %>
        <div
          class="mx-4 mt-2 max-w-full truncate rounded-full bg-blue-600 px-2 py-1 text-center font-medium text-white <%= grid_layout ? "text-xs" : "text-sm" %>"
          aria-label="<%= sponsor.badge %>"
        >
          <%= sponsor.badge %>
        </div>
      <% end %>

      <% unless defined?(hide_event_count) && hide_event_count %>
        <div class="text-slate-600 <%= grid_layout ? "text-xs sm:text-sm" : "text-base" %>">
          <%= pluralize(organization.events.size, "event") %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
