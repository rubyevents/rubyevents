<div class="container py-8 hotwire-native:py-3">
  <h1 class="title hotwire-native:hidden">
    <%= title "Organizations" %>
  </h1>

  <div class="mb-8 mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 hotwire-native:hidden">
    <div class="flex items-start">
      <%= fa("question-circle", size: :sm, class: "fill-amber-600 mt-0.5 mr-3 flex-shrink-0") %>

      <div>
        <h3 class="mb-1 font-semibold text-amber-800">Organization data is incomplete</h3>

        <p class="mb-2 text-sm text-amber-700">
          Many conferences are still missing sponsor information. Help us complete the database!
        </p>

        <%= link_to "View conferences missing sponsor data", sponsors_missing_index_path, class: "text-sm font-medium text-amber-800 underline hover:text-amber-900" %>
      </div>
    </div>
  </div>

  <% if @featured_organizations.present? %>
    <% cache @featured_organizations do %>
      <div class="my-8 hotwire-native:hidden">
        <div class="relative" data-controller="scroll">
          <div
            class="snap-x snap-mandatory overflow-x-auto scroll-smooth"
            data-scroll-target="container"
            data-action="scroll->scroll#checkScroll"
          >
            <div class="flex gap-4 pb-4">
              <% @featured_organizations.each do |organization| %>
                <div class="snap-start" data-scroll-target="card">
                  <%= render partial: "organizations/card", locals: {organization: organization}, cached: true %>
                </div>
              <% end %>
            </div>
          </div>

          <div
            class="pointer-events-none absolute right-0 top-0 h-full w-24 bg-gradient-to-l from-white to-transparent"
            data-scroll-target="gradient"
          ></div>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="flex w-full flex-wrap justify-between gap-1 py-8 hotwire-native:hidden">
    <% ("a".."z").each do |letter| %>
      <%= link_to organizations_path(letter: letter), class: class_names("flex items-center justify-center w-10 text-gray-500 rounded hover:bg-brand-lighter border", "bg-brand-lighter": letter == params[:letter]) do %>
        <%= letter.upcase %>
      <% end %>
    <% end %>
  </div>

  <div
    id="organizations"
    class="grid min-w-full gap-x-8 gap-y-2 hotwire-native:mt-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-12 xl:grid-cols-4"
  >
    <% cache @organizations do %>
      <%= render partial: "organizations/organization", collection: @organizations, as: :organization, cached: true %>
    <% end %>
  </div>
</div>
