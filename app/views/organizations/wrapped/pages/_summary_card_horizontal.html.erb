<div class="flex flex-1 items-center gap-12 px-12 pb-4 pt-8">
  <div class="flex flex-col items-center">
    <% if organization.logo_url.present? %>
      <div class="mb-6 h-32 w-32 overflow-hidden rounded-2xl bg-white p-3">
        <%= image_tag organization.logo_url, class: "w-full h-full object-contain", alt: organization.name %>
      </div>
    <% end %>

    <p class="text-lg text-red-300"><%= organization.name %></p>

    <h1 class="mt-2 text-6xl font-black text-white"><%= year %></h1>

    <p class="mt-1 text-3xl font-bold text-red-200">Wrapped</p>
    <p class="mt-4 text-sm text-red-300/80">RubyEvents.org/Wrapped</p>
  </div>

  <div class="grid flex-1 grid-cols-2 gap-6">
    <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur">
      <p class="text-6xl font-black text-white"><%= total_events_sponsored %></p>
      <p class="mt-2 text-lg text-red-200">Events Supported</p>
    </div>

    <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur">
      <p class="text-6xl font-black text-white"><%= number_with_delimiter(talks_at_sponsored_events) %></p>
      <p class="mt-2 text-lg text-red-200">Talks Supported</p>
    </div>

    <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur">
      <p class="text-6xl font-black text-white"><%= number_with_delimiter(speakers_at_sponsored_events) %></p>
      <p class="mt-2 text-lg text-red-200">Speakers Supported</p>
    </div>

    <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur">
      <p class="text-6xl font-black text-white"><%= countries_sponsored.count %></p>
      <p class="mt-2 text-lg text-red-200">Countries Reached</p>
    </div>
  </div>
</div>

<div class="mt-4 flex w-full items-center justify-center gap-3 bg-white/5 py-3">
  <%= image_tag "logo.png", class: "w-6 h-6", alt: "RubyEvents.org" %>
  <span class="text-lg font-bold text-white">RubyEvents.org</span>
  <span class="text-sm text-red-300/80">On a mission to index all Ruby events</span>
</div>
