<%# locals: (organization:) %>

<% if organization.has_logo_image? %>
  <div class="size-8 rounded border border-[#D9DFE3] p-1 <%= organization.logo_background_class %>">
    <%= image_tag organization.logo_image_path,
          class: "w-full h-full object-contain",
          alt: "#{organization.name} Logo",
          loading: "lazy",
          onerror: "this.style.display='none'; this.nextElementSibling.style.display='flex';" %>

    <div class="avatar placeholder hidden">
      <div class="flex h-full w-full items-center justify-center bg-gray-100 text-gray-600">
        <span class="text-sm font-bold"><%= organization.name.split(" ").map(&:first).join.first(2) %></span>
      </div>
    </div>
  </div>
<% elsif organization.organization_image_for("avatar.webp") %>
  <%= image_tag image_path(organization.avatar_image_path), alt: organization.name, class: "size-8 rounded border border-[#D9DFE3]", loading: "lazy" %>
<% else %>
  <div class="avatar placeholder">
    <div class="flex size-8 items-center justify-center rounded border border-[#D9DFE3] bg-gray-100 text-gray-600">
      <span class="text-sm font-bold"><%= organization.name.split(" ").map(&:first).join.first(2) %></span>
    </div>
  </div>
<% end %>
