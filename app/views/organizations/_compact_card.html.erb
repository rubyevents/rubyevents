<%= link_to organization_path(organization), class: "flex flex-col gap-4 hover:bg-gray-200 transition-bg duration-300 ease-in-out p-2 px-4 rounded-lg", data: {turbo_frame: ((defined?(turbo_frame) && turbo_frame) ? "_top" : nil)} do %>
  <div class="flex items-center gap-4">
    <% if organization.has_logo_image? %>
      <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg border p-2 <%= organization.logo_background_class %> <%= organization.logo_border_class %>">
        <%= image_tag(
              organization.logo_image_path,
              alt: "#{organization.name} logo",
              class: "w-10 h-10 object-contain",
              loading: "lazy",
              onerror: "this.style.display='none'; this.nextElementSibling.style.display='flex';"
            ) %>

        <div class="h-10 w-10 items-center justify-center" style="display: none;">
          <span class="line-clamp-2 text-center text-xs font-semibold text-gray-700"><%= organization.name %></span>
        </div>
      </div>
    <% else %>
      <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-100">
        <span class="line-clamp-2 text-center text-xs font-semibold text-gray-700"><%= organization.name[0..1].upcase %></span>
      </div>
    <% end %>

    <div class="min-w-0 flex-1">
      <div class="line-clamp-1 text-base font-bold">
        <%= organization.name %>
      </div>

      <div class="line-clamp-1 text-xs text-gray-500">
        <% if defined?(sponsor) && sponsor&.badge.present? %>
          <%= sponsor.badge %>
        <% elsif !defined?(hide_event_count) || !hide_event_count %>
          <%= pluralize(organization.events.size, "event") %>
        <% else %>
          <%= organization.website&.gsub(%r{https?://}, "")&.gsub(%r{www\.}, "")&.split("/")&.first || "-" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
