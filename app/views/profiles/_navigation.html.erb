<%# locals: (user:, favorite_user:, talks:, events:, mutual_events:, stamps:, stickers:, involvements_by_role:, countries_with_events:) %>

<% on_profile_root = current_page?(profile_path(user)) %>
<% talks_active = current_page?(profile_talks_path(user)) || (on_profile_root && talks.length.positive?) %>
<% events_active = current_page?(profile_events_path(user)) || (on_profile_root && talks.length.zero?) %>

<% tab_class = "tab whitespace-nowrap max-md:text-xs max-md:px-2.5 max-md:py-1 max-md:h-auto max-md:min-h-6 max-md:leading-tight max-md:rounded-lg" %>

<div class="pb-3.5 pt-3 md:pb-0 md:pt-0">
  <div role="tablist" class="tabs-boxed tabs inline-flex flex-wrap gap-1 max-md:rounded-xl max-md:p-1.5">
    <% if talks.length.positive? %>
      <%= active_link_to "Talks (#{talks.size})", profile_talks_path(user), active: talks_active, class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if events.any? %>
      <%= active_link_to "Attended Events (#{events.size})", profile_events_path(user), active: events_active, class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if mutual_events&.any? && Current.user && Current.user != user %>
      <%= active_link_to "Mutual Events (#{mutual_events.size})", profile_mutual_events_path(user), class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if favorite_user&.persisted? %>
      <%= active_link_to "Notes", profile_notes_path(user), class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if involvements_by_role.any? %>
      <%= active_link_to "Involvements", profile_involvements_path(user), class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if stamps.any? %>
      <%= active_link_to "Stamps (#{stamps.size})", profile_stamps_path(user), class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if stickers.any? %>
      <%= active_link_to "Stickers (#{stickers.size})", profile_stickers_path(user), class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if countries_with_events&.any? %>
      <%= active_link_to "Map", profile_map_index_path(user), class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if user.ruby_passport_claimed? %>
      <%= active_link_to "Ruby Passport", profile_passport_index_path(user), class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>

    <% if Current.user&.admin? %>
      <%= active_link_to "Aliases (#{user.aliases.size})", profile_aliases_path(user), class: tab_class, active_class: "tab-active", role: "tab" %>
    <% end %>
  </div>
</div>
