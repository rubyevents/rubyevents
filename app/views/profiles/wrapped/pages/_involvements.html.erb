<h2 class="mb-2 text-center text-2xl font-bold">Community Builder</h2>

<p class="mb-6 text-center text-gray-500">Thank you for helping make Ruby events happen!</p>

<div class="flex flex-1 flex-col items-center justify-center">
  <div class="relative mb-6 h-24 w-24">
    <div class="absolute inset-0 animate-pulse rounded-full bg-gradient-to-br from-purple-400 to-purple-600 opacity-30"></div>

    <div class="absolute inset-2 flex items-center justify-center rounded-full bg-gradient-to-br from-purple-500 to-purple-700">
      <span class="text-4xl">🙌</span>
    </div>
  </div>

  <div class="mb-6 text-center">
    <p class="mb-2 text-5xl font-black text-purple-600"><%= involvements_in_year.count %></p>
    <p class="text-gray-600"><%= "event".pluralize(involvements_in_year.count) %> you helped with</p>
  </div>

  <div class="w-full space-y-3">
    <% involvements_by_role.each do |role, involvements| %>
      <div class="rounded-xl bg-purple-50 p-4">
        <div class="mb-2 flex items-center justify-between">
          <span class="font-semibold capitalize text-purple-700"><%= role %></span>
          <span class="text-sm text-purple-500"><%= involvements.count %> <%= "event".pluralize(involvements.count) %></span>
        </div>

        <div class="flex flex-wrap gap-1">
          <% involvements.first(4).each do |involvement| %>
            <span class="max-w-[120px] truncate rounded bg-white px-2 py-1 text-xs text-gray-600">
              <%= involvement.event.name %>
            </span>
          <% end %>

          <% if involvements.count > 4 %>
            <span class="rounded bg-white px-2 py-1 text-xs text-gray-400">
              +<%= involvements.count - 4 %> more
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-auto pt-4 text-center">
  <p class="text-sm text-gray-500">
    The Ruby community thrives because of people like you! 💜
  </p>
</div>
