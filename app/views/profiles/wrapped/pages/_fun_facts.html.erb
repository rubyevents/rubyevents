<h2 class="mb-2 text-center text-2xl font-bold">Fun Facts</h2>
<p class="mb-6 text-center text-gray-500">Some interesting tidbits about your year</p>

<div class="flex-1 space-y-4">
  <% if longest_streak.positive? %>
    <div class="rounded-lg border border-orange-200 bg-orange-50 p-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🔥</span>

        <div>
          <p class="font-semibold text-orange-700"><%= longest_streak %> Day Streak</p>
          <p class="text-sm text-gray-600">Your longest watching streak</p>
        </div>
      </div>
    </div>
  <% end %>

  <% if most_active_weekday %>
    <div class="rounded-lg border border-purple-200 bg-purple-50 p-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">📅</span>

        <div>
          <p class="font-semibold text-purple-700"><%= Date::DAYNAMES[most_active_weekday] %>s</p>
          <p class="text-sm text-gray-600">Your favorite day to watch talks</p>
        </div>
      </div>
    </div>
  <% end %>

  <% if most_active_month %>
    <div class="rounded-lg border border-teal-200 bg-teal-50 p-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">📆</span>

        <div>
          <p class="font-semibold text-teal-700"><%= Date::MONTHNAMES[most_active_month] %></p>
          <p class="text-sm text-gray-600">Your most active watching month</p>
        </div>
      </div>
    </div>
  <% end %>

  <% if longest_watched && longest_watched.talk.duration.present? %>
    <div class="rounded-lg border border-blue-200 bg-blue-50 p-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">⏱️</span>

        <div>
          <p class="font-semibold text-blue-700">Longest Talk: <%= longest_watched.talk.formatted_duration %></p>
          <p class="truncate text-sm text-gray-600"><%= longest_watched.talk.title.truncate(35) %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if shortest_watched && shortest_watched != longest_watched && shortest_watched.talk.duration.present? %>
    <div class="rounded-lg border border-green-200 bg-green-50 p-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">⚡</span>

        <div>
          <p class="font-semibold text-green-700">Shortest Talk: <%= shortest_watched.talk.formatted_duration %></p>
          <p class="truncate text-sm text-gray-600"><%= shortest_watched.talk.title.truncate(35) %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if events_discovered.positive? %>
    <div class="rounded-lg border border-pink-200 bg-pink-50 p-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🌍</span>

        <div>
          <p class="font-semibold text-pink-700"><%= events_discovered %> Events Discovered</p>
          <p class="text-sm text-gray-600">Different conferences you explored</p>
        </div>
      </div>
    </div>
  <% end %>

  <% if ruby_friends_met.positive? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">👋</span>

        <div>
          <p class="font-semibold text-red-700"><%= ruby_friends_met %> Ruby Friends</p>
          <p class="text-sm text-gray-600">Crossed paths with <%= ruby_friends_met %> Rubyists from RubyEvents.org</p>
        </div>
      </div>
    </div>
  <% end %>
</div>
