<h2 class="mb-2 text-center text-2xl font-bold">Events You Explored Talks From</h2>

<p class="mb-6 text-center text-gray-500">Conferences that shared their knowledge with you</p>

<% if top_events.any? %>
  <div class="rank-list flex-1">
    <% top_events.each do |event, count| %>
      <div class="rank-item">
        <div class="flex-1">
          <p class="font-semibold"><%= event.name %></p>
          <p class="text-sm text-gray-500"><%= count %> <%= "talk".pluralize(count) %> watched</p>
        </div>
      </div>
    <% end %>
  </div>

  <% if countries_watched.any? %>
    <div class="mt-auto pt-4">
      <p class="mb-2 text-sm text-gray-500">Countries explored through talks:</p>

      <div class="flex flex-wrap gap-2">
        <% countries_watched.first(8).each do |country| %>
          <span class="rounded bg-red-50 px-2 py-1 text-xs font-medium text-red-700">
            <%= country.name %>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="flex flex-1 items-center justify-center">
    <p class="text-center text-gray-400">Watch talks to explore events from around the world!</p>
  </div>
<% end %>
