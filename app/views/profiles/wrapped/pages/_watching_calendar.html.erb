<h2 class="mb-2 text-center text-2xl font-bold">Your Watching Calendar</h2>

<p class="mb-6 text-center text-gray-500">When you tuned in throughout the year</p>

<% if monthly_breakdown.any? %>
  <% max_count = monthly_breakdown.values.max || 1 %>
  <div class="flex-1 space-y-3">
    <% (1..12).each do |month| %>
      <% count = monthly_breakdown[month] || 0 %>
      <% width = count.positive? ? (count.to_f / max_count * 100).round : 0 %>

      <div class="flex items-center gap-3">
        <span class="w-8 text-sm text-gray-500"><%= Date::ABBR_MONTHNAMES[month] %></span>

        <div class="h-2 flex-1 rounded-full bg-gray-100">
          <div class="month-bar" style="width: <%= width %>%"></div>
        </div>

        <span class="w-8 text-right text-sm text-gray-600"><%= count %></span>
      </div>
    <% end %>
  </div>

  <% if most_active_month %>
    <div class="highlight-box mt-6 pt-4">
      <p class="font-semibold text-red-700">
        <%= Date::MONTHNAMES[most_active_month] %> was your most active month!
      </p>

      <p class="text-sm text-gray-600">
        You watched <%= monthly_breakdown[most_active_month] %> talks
      </p>
    </div>
  <% end %>
<% else %>
  <div class="flex flex-1 items-center justify-center">
    <p class="text-center text-gray-400">Start watching to build your calendar!</p>
  </div>
<% end %>
