<h2 class="mb-2 text-center text-2xl font-bold">Your Event Map</h2>

<p class="mb-6 text-center text-gray-500">Where Ruby took you in <%= year %></p>

<div class="flex flex-1 items-center">
  <div
    id="wrapped-map"
    class="h-[400px] w-full rounded-lg"
    data-controller="map"
    data-map-markers-value="<%= event_map_markers.to_json %>"
  ></div>
</div>

<div class="mt-4 text-center text-sm text-gray-500">
  <%= countries_visited.count %> <%= (countries_visited.count == 1) ? "country" : "countries" %> visited
</div>
