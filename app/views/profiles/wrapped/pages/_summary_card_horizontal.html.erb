<div class="flex flex-1 items-center gap-12 px-12 pb-4 pt-8">
  <div class="flex flex-col items-center">
    <div class="mb-6 h-32 w-32 overflow-hidden rounded-full border-4 border-white bg-white/20">
      <% if user.custom_avatar? %>
        <%= image_tag user.avatar_url(size: 256), class: "w-full h-full object-cover", alt: user.name %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center text-5xl font-bold text-white">
          <%= user.name.first.upcase %>
        </div>
      <% end %>
    </div>

    <p class="text-lg text-red-300"><%= user.name %></p>

    <h1 class="mt-2 text-6xl font-black text-white"><%= year %></h1>

    <p class="mt-1 text-3xl font-bold text-red-200">Wrapped</p>
    <p class="mt-4 text-sm text-red-300/80">RubyEvents.org/Wrapped</p>
  </div>

  <div class="grid flex-1 grid-cols-2 gap-6">
    <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur">
      <p class="text-6xl font-black text-white"><%= total_talks_watched %></p>
      <p class="mt-2 text-lg text-red-200">Talks Watched</p>
    </div>

    <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur">
      <p class="text-6xl font-black text-white"><%= total_watch_time_hours %>h</p>
      <p class="mt-2 text-lg text-red-200">Watch Time</p>
    </div>

    <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur">
      <p class="text-6xl font-black text-white"><%= events_attended_in_year.count %></p>
      <p class="mt-2 text-lg text-red-200">Events Attended</p>
    </div>

    <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur">
      <p class="text-6xl font-black text-white"><%= countries_visited.count %></p>
      <p class="mt-2 text-lg text-red-200">Countries Visited</p>
    </div>
  </div>
</div>

<div class="mt-4 flex w-full items-center justify-center gap-3 bg-white/5 py-3">
  <%= image_tag "logo.png", class: "w-6 h-6", alt: "RubyEvents.org" %>
  <span class="text-lg font-bold text-white">RubyEvents.org</span>
  <span class="text-sm text-red-300/80">On a mission to index all Ruby events</span>
</div>
