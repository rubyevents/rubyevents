<h2 class="mb-2 text-center text-2xl font-bold">Your Top Topics</h2>

<p class="mb-6 text-center text-gray-500">The subjects that captured your interest</p>

<% if top_topics.any? %>
  <div class="rank-list flex-1">
    <% top_topics.each do |topic, count| %>
      <div class="rank-item">
        <div class="flex-1">
          <p class="font-semibold"><%= topic.name %></p>
          <p class="text-sm text-gray-500"><%= count %> <%= "talk".pluralize(count) %></p>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-auto pt-6 text-center">
    <p class="mb-2 text-sm text-gray-500">Your Ruby Personality</p>
    <div class="personality-badge"><%= personality %></div>
  </div>
<% else %>
  <div class="flex flex-1 items-center justify-center">
    <p class="text-center text-gray-400">Watch some talks to discover your favorite topics!</p>
  </div>
<% end %>
