<h2 class="mb-2 text-center text-2xl font-bold">Stickers Collected</h2>

<p class="mb-4 text-center text-gray-500">Event stickers from <%= year %></p>

<div class="w-full flex-1 overflow-hidden rounded-2xl bg-gradient-to-b from-gray-300 via-gray-600 to-gray-600 p-[3px]">
  <div
    class="
      flex h-full w-full items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-b from-gray-400
      via-gray-500 to-gray-600 p-4
    "
  >
    <div class="grid w-full grid-cols-3 place-items-center content-center gap-3">
      <% stickers_earned.shuffle.each do |sticker| %>
        <% rotation = rand(-15..15)
           translate_x = rand(-10..10)
           translate_y = rand(-10..10)
           scale = rand(90..110) %>

        <%= link_to sticker.event, class: "w-16 h-16 md:w-20 md:h-20 transition-transform hover:scale-110 hover:z-10", style: "transform: rotate(#{rotation}deg) translateX(#{translate_x}px) translateY(#{translate_y}px) scale(#{scale}%);", data: {turbo_frame: "_top"} do %>
          <%= image_tag sticker.asset_path, alt: sticker.name, class: "w-full h-full object-contain drop-shadow-lg" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-4 text-center text-sm text-gray-500">
  <%= stickers_earned.count %> sticker<%= (stickers_earned.count == 1) ? "" : "s" %> collected
</div>
