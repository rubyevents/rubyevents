<h2 class="mb-2 text-center text-2xl font-bold">Bookends of <%= year %></h2>
<p class="mb-6 text-center text-gray-500">Where your watching journey started and ended</p>

<div class="flex-1 space-y-6">
  <div>
    <p class="mb-2 text-sm text-gray-500">🎬 Your first watch of the year:</p>

    <div class="rounded-lg border border-green-200 bg-green-50 p-4">
      <p class="font-semibold"><%= first_watched.talk.title.truncate(60) %></p>

      <p class="mt-1 text-sm text-gray-600">
        by <%= first_watched.talk.speakers.map(&:name).join(", ").truncate(40) %>
      </p>

      <p class="mt-2 text-xs text-gray-400">
        <%= first_watched.created_at.strftime("%B %d, %Y") %>
      </p>
    </div>
  </div>

  <div>
    <p class="mb-2 text-sm text-gray-500">🏁 Your last watch of the year:</p>

    <div class="rounded-lg border border-blue-200 bg-blue-50 p-4">
      <p class="font-semibold"><%= last_watched.talk.title.truncate(60) %></p>

      <p class="mt-1 text-sm text-gray-600">
        by <%= last_watched.talk.speakers.map(&:name).join(", ").truncate(40) %>
      </p>

      <p class="mt-2 text-xs text-gray-400">
        <%= last_watched.created_at.strftime("%B %d, %Y") %>
      </p>
    </div>
  </div>
</div>
