<div class="flex flex-1 flex-col items-center justify-center">
  <div class="border-3 mx-auto mb-3 h-20 w-20 overflow-hidden rounded-full border-white bg-white/20">
    <% if user.custom_avatar? %>
      <%= image_tag user.avatar_url(size: 80), class: "w-full h-full object-cover", alt: user.name %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center text-2xl font-bold">
        <%= user.name.first.upcase %>
      </div>
    <% end %>
  </div>

  <p class="mb-1 text-lg font-bold"><%= user.name %></p>
  <p class="mb-6 text-sm text-red-200">RubyEvents.org <%= year %> Wrapped</p>

  <% if top_speakers.any? %>
    <div class="mb-1 flex justify-center -space-x-2">
      <% top_speakers.first(5).each do |speaker, _| %>
        <div class="h-8 w-8 overflow-hidden rounded-full border-2 border-red-600 bg-white/20">
          <%= image_tag speaker.avatar_url(size: 40), class: "w-full h-full object-cover", alt: speaker.name %>
        </div>
      <% end %>
    </div>
    <p class="mb-6 text-[10px] text-red-200">Favorite Speakers</p>
  <% end %>

  <div class="mb-2 grid w-full max-w-xs grid-cols-2 gap-2">
    <div class="rounded-lg bg-white/10 p-2 text-center">
      <p class="text-xl font-bold"><%= total_talks_watched %></p>
      <p class="text-[10px] text-red-200">Talks Watched</p>
    </div>

    <div class="rounded-lg bg-white/10 p-2 text-center">
      <p class="text-xl font-bold"><%= total_watch_time_hours %>h</p>
      <p class="text-[10px] text-red-200">Watch Time</p>
    </div>
  </div>

  <div class="mb-2 grid w-full max-w-xs grid-cols-2 gap-2">
    <div class="rounded-lg bg-white/10 p-2 text-center">
      <p class="text-xl font-bold"><%= events_attended_in_year.count %></p>
      <p class="text-[10px] text-red-200">Events Attended</p>
    </div>

    <div class="rounded-lg bg-white/10 p-2 text-center">
      <p class="text-xl font-bold"><%= countries_visited.count %></p>
      <p class="text-[10px] text-red-200">Countries Visited</p>
    </div>
  </div>

  <% if talks_given_in_year.any? %>
    <div class="mb-6 grid w-full max-w-xs grid-cols-2 gap-2">
      <div class="rounded-lg bg-white/20 p-2 text-center">
        <p class="text-xl font-bold"><%= talks_given_in_year.count %></p>
        <p class="text-[10px] text-red-200">Talks Given</p>
      </div>

      <div class="rounded-lg bg-white/20 p-2 text-center">
        <p class="text-xl font-bold">
          <%= number_to_human(total_views_on_talks, units: {thousand: "K", million: "M"}, format: "%n%u") %>
        </p>

        <p class="text-[10px] text-red-200">Views on YouTube</p>
      </div>
    </div>
  <% end %>

  <% if involvements_in_year.any? %>
    <div class="mb-6 grid w-full max-w-xs grid-cols-1 gap-2">
      <div class="rounded-lg bg-purple-500/30 p-2 text-center">
        <p class="text-xl font-bold"><%= involvements_in_year.count %></p>
        <p class="text-[10px] text-red-200">Events Helped Organize</p>
      </div>
    </div>
  <% end %>

  <% if personality.present? %>
    <div class="personality-badge mb-6 px-4 py-2 text-sm">
      <%= personality %>
    </div>
  <% end %>

  <% if top_topics.any? %>
    <div class="flex max-w-xs flex-wrap justify-center gap-1">
      <% top_topics.first(3).each do |topic, _| %>
        <span class="rounded bg-white/10 px-2 py-1 text-xs"><%= topic.name %></span>
      <% end %>
    </div>
  <% end %>
</div>

<div class="mt-auto flex flex-col items-center pt-4">
  <%= image_tag "logo.png", class: "w-8 h-8 mb-1", alt: "RubyEvents.org" %>

  <p class="text-xs font-bold text-red-200">RubyEvents.org/Wrapped</p>
</div>
