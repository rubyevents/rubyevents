<h2 class="mb-2 text-center text-2xl font-bold">Your Watch Twin</h2>
<p class="mb-6 text-center text-gray-500">Someone with similar taste in talks</p>

<div class="flex flex-1 flex-col items-center justify-center">
  <div class="mb-4 h-24 w-24 overflow-hidden rounded-full bg-gray-200 ring-4 ring-red-200">
    <%= image_tag watch_twin.user.avatar_url(size: 200), class: "w-full h-full object-cover", alt: watch_twin.user.name %>
  </div>

  <p class="text-xl font-bold"><%= watch_twin.user.name %></p>

  <p class="mt-2 text-gray-500">
    watched <span class="font-semibold text-red-600"><%= watch_twin.shared_count %></span> of the same talks
  </p>

  <p class="mt-1 text-sm text-gray-400"><%= watch_twin.percentage %>% overlap with your watched talks</p>

  <div class="mt-6 rounded-lg bg-red-50 p-4 text-center">
    <p class="mb-2 text-2xl">👯</p>
    <p class="text-sm text-gray-600">Great minds watch alike!</p>
  </div>
</div>
