<div class="flex flex-1 flex-col items-center justify-center">
  <div class="mb-3 h-28 w-28 overflow-hidden rounded-full border-4 border-white bg-white/20">
    <% if user.custom_avatar? %>
      <%= image_tag user.avatar_url(size: 140), class: "w-full h-full object-cover", alt: user.name %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center text-3xl font-bold">
        <%= user.name.first.upcase %>
      </div>
    <% end %>
  </div>

  <p class="mb-8 text-3xl font-bold"><%= user.name %></p>

  <p class="mb-1 text-xl text-red-200">RubyEvents.org</p>

  <h1 class="mb-1 text-7xl font-black"><%= year %></h1>

  <p class="text-4xl font-bold">Wrapped</p>
</div>

<div class="mt-auto flex items-center justify-center gap-3">
  <%= image_tag "logo.png", class: "w-8 h-8", alt: "RubyEvents.org" %>

  <p class="text-lg text-red-200">
    See <%= user.name.split.first %>'s full Wrapped at <span class="font-bold text-white">RubyEvents.org/Wrapped</span>
  </p>
</div>
