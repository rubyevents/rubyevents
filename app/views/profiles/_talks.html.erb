<% if talks.length.positive? %>
  <div class="flex flex-col gap-3.5 pt-0.5 md:hidden">
    <%= render partial: "talks/card_horizontal",
          collection: talks,
          as: :talk,
          locals: {
            user_watched_talks: user_watched_talks,
            show_event_name: true,
            variant: :profile,
            tooltip: false
          } %>
  </div>

  <div class="hidden md:block mt-2" data-controller="events-filter" data-events-filter-current-value="all">
    <% talk_kinds = talks.map(&:kind).uniq.sort %>
    <% if talk_kinds.any? %>
      <%= render "shared/filter_buttons", kinds: talk_kinds, current_filter: "all" %>
    <% end %>

    <div class="grid grid-cols-1 gap-8 min-w-full sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <% talks.each do |talk| %>
        <div data-events-filter-target="event" data-kind="<%= talk.kind %>">
          <%= render partial: "talks/card",
                locals: {
                  talk: talk,
                  favoritable: true,
                  user_favorite_talks_ids: user_favorite_talks_ids,
                  user_watched_talks: user_watched_talks,
                  back_to: back_to_from_request,
                  back_to_title: user.name
                } %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
