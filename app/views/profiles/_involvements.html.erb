<%# locals: (events:, user:, involvements_by_role:) %>

<% cache [user, involvements_by_role, Current.user] do %>
  <% if involvements_by_role.any? %>
    <div class="space-y-8">
      <% if involvements_by_role.any? %>
        <% involvements_by_role.each do |role, events| %>
          <div>
            <h3 class="mb-4 text-lg font-semibold">
              Involved as <%= role %>
            </h3>

            <div class="mb-6">
              <div class="grid min-w-full grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
                <%= cache events do %>
                  <%= render partial: "events/card", collection: events, as: :event, cached: true %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="py-12 text-center">
          <div class="mb-6">
            <h3 class="mb-2 text-lg font-semibold text-gray-900">No involvements yet</h3>

            <p class="mx-auto mb-6 max-w-xl text-gray-600">
              <% if Current.user == user %>
                You don't have any event involvements recorded yet.
              <% else %>
                <%= user.name %> doesn't have any event involvements recorded yet.
              <% end %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
