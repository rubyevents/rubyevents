<% if countries_with_events.any? %>
  <div role="tablist" class="tabs-boxed tabs mt-2 bg-base-100">
    <input type="radio" name="map_view" role="tab" class="tab !rounded-lg px-6" aria-label="Map" checked>

    <div role="tabpanel" class="tab-content mt-6">
      <div
        id="profile-map"
        class="h-[600px] w-full rounded-lg md:h-[800px]"
        data-controller="map"
        data-map-markers-value="<%= event_map_markers.to_json %>"
      ></div>
    </div>

    <input type="radio" name="map_view" role="tab" class="tab !rounded-lg px-6" aria-label="List">

    <div role="tabpanel" class="tab-content mt-6">
      <div class="space-y-8">
        <% countries_with_events.group_by { |country, _| country.continent_name }.sort_by(&:first).each do |continent, countries_group| %>
          <div>
            <h3 class="mb-4 text-lg font-semibold"><%= continent %></h3>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <% countries_group.each do |country, events| %>
                <%= render "shared/country_card", country: country, events: events %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
