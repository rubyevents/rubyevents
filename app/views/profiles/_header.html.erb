<%# locals: (user:, favorite_user:) %>

<div class="block lg:flex gap-8 align-center justify-between" id="<%= dom_id(user, :header) %>" data-controller="<%= "passport-book" if user.ruby_passport_claimed? %>">
  <%= render "profiles/header_content", user:, favorite_user: %>

  <div class="flex flex-col gap-2 items-start lg:max-w-[250px]">
    <%= render "profiles/actions", user: user %>
  </div>

  <% if user.ruby_passport_claimed? %>
    <%= render "profiles/passport_book", user: user %>
  <% end %>
</div>
