<%# locals: (user:, favorite_user:) %>

<div class="block lg:flex gap-8 align-center justify-between" id="<%= dom_id(user, :header) %>">
  <%= render "profiles/header_content", user:, favorite_user: %>

  <%# captured so the wrapper is skipped for user_kinds that render no actions %>
  <% actions = capture { render "profiles/actions", user: user } %>
  <% if actions.strip.present? %>
    <div class="flex flex-col gap-2 items-start lg:max-w-[250px] py-3 md:py-0">
      <%= actions %>
    </div>
  <% end %>
</div>
