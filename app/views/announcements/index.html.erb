<% content_for :head do %>
  <% if @current_tag.present? %>
    <%= auto_discovery_link_tag :rss, feed_announcements_url(format: :rss, tag: @current_tag), title: "RubyEvents.org Announcements - #{@current_tag}" %>
  <% else %>
    <%= auto_discovery_link_tag :rss, feed_announcements_url(format: :rss), title: "RubyEvents.org Announcements" %>
  <% end %>
<% end %>

<div class="container py-8">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="title text-primary"><%= title "Announcements" %></h1>

    <%= link_to feed_announcements_path(format: :rss, tag: @current_tag.presence), class: "btn btn-ghost btn-sm gap-2", title: "RSS Feed", target: "_blank" do %>
      <%= fa("rss", size: :sm) %>
    <% end %>
  </div>

  <% if @current_tag.present? %>
    <div class="mb-6 flex items-center gap-2">
      <span class="text-gray-500">Filtered by:</span>

      <span class="badge badge-primary gap-1">
        <%= @current_tag %>

        <%= link_to announcements_path(**permitted_params) do %>
          <%= fa("xmark", size: :xs, class: "fill-white") %>
        <% end %>
      </span>
    </div>
  <% end %>

  <div class="flex flex-col gap-8">
    <% @announcements.each do |announcement| %>
      <article class="card border border-base-200 bg-base-100 shadow-sm">
        <div class="card-body">
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2 text-sm text-gray-500">
              <time datetime="<%= announcement.date.iso8601 %>"><%= I18n.l(announcement.date, default: "") %></time>

              <% if announcement.author_user %>
                <span>•</span>
                <%= link_to profile_path(announcement.author_user), class: "hover:underline" do %>
                  @<%= announcement.author %>
                <% end %>
              <% elsif announcement.author.present? %>
                <span>•</span>
                <span><%= announcement.author %></span>
              <% end %>

              <% if !announcement.published? %>
                <span class="badge badge-warning">Draft</span>
              <% end %>
            </div>

            <h2 class="card-title">
              <%= link_to announcement.title, announcement_path(announcement, **permitted_params), class: "hover:underline" %>
            </h2>

            <% if announcement.excerpt.present? %>
              <p class="text-gray-600"><%= announcement.excerpt %></p>
            <% end %>

            <% if announcement.tags.any? %>
              <div class="mt-2 flex flex-wrap gap-2">
                <% announcement.tags.each do |tag| %>
                  <%= link_to announcements_path(tag: tag, **permitted_params), class: "badge badge-ghost hover:badge-primary px-2 py-3 text-xs transition-colors" do %>
                    <%= tag %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="card-actions mt-4 justify-end">
            <%= link_to "Read more →", announcement_path(announcement, **permitted_params), class: "text-primary hover:underline" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>

  <% if @announcements.empty? %>
    <div class="py-12 text-center text-gray-500">
      No announcements yet.
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="mt-8 flex w-full justify-center">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
