
- id: "<%= @talk.id %>"
  title: "<%= @talk.title %>"
<%- if @talk.description.blank? -%>
  description: "" # TODO
<%- else -%>
  description: |-
<%= optimize_indentation(@talk.description, 4) %>
<%- end -%>
  kind: "lightning_talk"
  language: "<%= @talk.language %>"
  date: "<%= @talk.date %>"
<%- if @talk.track.present? -%>
  track: "<%= @talk.track %>"
<%- end -%>
  talks: []
  video_provider: "scheduled"
  video_id: "<%= @talk.id %>"
