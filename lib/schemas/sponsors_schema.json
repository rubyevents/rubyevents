{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SponsorsSchema",
  "type": "object",
  "properties": {
    "tiers": {
      "type": "array",
      "description": "List of sponsorship tiers",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Sponsorship Tier Name"
          },
          "description": {
            "type": "string",
            "description": "Description of the sponsorship tier"
          },
          "level": {
            "type": "integer",
            "description": "Sponsorship level (lower number indicates higher level)"
          },
          "sponsors": {
            "type": "array",
            "description": "List of sponsors in this tier",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Sponsor Name"
                },
                "slug": {
                  "type": "string",
                  "description": "Sponsor identifier slug"
                },
                "website": {
                  "type": "string",
                  "description": "Sponsor's website URL"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the sponsor"
                },
                "logo_url": {
                  "type": "string",
                  "description": "URL to the sponsor's logo image"
                },
                "badge": {
                  "type": "string",
                  "description": "Sponsor badge text"
                },
                "from": {
                  "type": "string",
                  "description": "When the sponsorship started (YYYY, YYYY-MM or YYYY-MM-DD), for a series' sponsors.yml",
                  "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
                },
                "to": {
                  "type": "string",
                  "description": "When the sponsorship ended (YYYY, YYYY-MM or YYYY-MM-DD), for a series' sponsors.yml, omitted while it lasts",
                  "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
                }
              },
              "required": [
                "name",
                "slug",
                "website"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sponsors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tiers"
  ],
  "additionalProperties": false
}