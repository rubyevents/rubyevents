{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeriesSchema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the event series, matches the series folder name"
    },
    "old_ids": {
      "type": "array",
      "description": "Previous ids, kept so the production series is moved to the new id on the next seed and its old URLs keep working",
      "items": {
        "type": "string"
      }
    },
    "old_event_ids": {
      "type": "array",
      "description": "Ids of events merged into this series, like a meetup group's event that held all its meetups. The next seed moves their records to the series and redirects their URLs",
      "items": {
        "type": "string"
      }
    },
    "removed_talk_ids": {
      "type": "array",
      "description": "Ids of talks of merged events that were intentionally removed",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string",
      "description": "Name of the event series (e.g., 'RailsConf')"
    },
    "meetup_name": {
      "type": "string",
      "description": "Name a meetup group's meetups go by in their titles, when it differs from its name (e.g., 'LRUG')"
    },
    "description": {
      "type": "string",
      "description": "Description of the event series"
    },
    "kind": {
      "type": "string",
      "enum": [
        "conference",
        "meetup",
        "retreat",
        "hackathon",
        "event",
        "podcast",
        "online",
        "organisation",
        "workshop"
      ],
      "description": "Type of event series"
    },
    "ended": {
      "type": "boolean",
      "description": "The series stopped for good. A meetup group without an upcoming meetup and none in 18 months counts as inactive anyway"
    },
    "default_country_code": {
      "type": "string",
      "description": "Default ISO country code (e.g., 'US', 'JP')"
    },
    "location": {
      "type": "string",
      "description": "Where a meetup group meets, in 'City, Country' format (e.g., 'London, UK'), or 'online'"
    },
