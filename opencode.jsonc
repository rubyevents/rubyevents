{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "rubyevents": {
      "type": "local",
      "command": [
        "bin/mcp_server"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "herb": {
      "command": [
        "herb-language-server",
        "--stdio"
      ],
      "extensions": [
        ".erb"
      ]
    }
  }
}